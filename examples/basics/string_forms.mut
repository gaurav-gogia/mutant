// The three string spellings: interpolated, raw and triple-quoted.

let host = "10.0.0.7";
let port = 4444;
let hits = [92, 38, 12];
let loudest = max(hits[0], hits[1], hits[2]);

putln("beacon ${host}:${port}");
putln("largest hit: ${loudest}, total ${sum(hits)}");
putln("coverage ${len(hits) * 10}% of the window");
putln("price $5, template \${name}");

let runkey = r"HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run";
let datestamp = r"\d{4}-\d{2}-\d{2}";
let date = "2026-09-12";
putln(runkey);
putln("matches a date? ${regex_match(datestamp, date)}");

// The closing delimiter sets the left margin of a triple-quoted literal.
let summary = """
    beacon report
      endpoint : ${host}:${port}
      hits     : ${len(hits)}
      loudest  : ${loudest}
      run key  : ${runkey}
    """;
putln(summary);

let quoted = """
    the analyst said "check ${host}" and left
    """;
putln(quoted);

let rule = r"""
    rule beacon_marker {
      strings:
        $path = "C:\Windows\Temp\svc.exe"
        $re   = /\d{1,3}(\.\d{1,3}){3}/
      condition:
        $path or $re
    }
    """;
putln(rule);
