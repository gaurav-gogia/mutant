// Reads two numbers from the terminal and adds them.

let sum = fn(a, b) {
    return a + b;
};

putln("Lets add two numbers: ");
putf("Enter first number: ");
let num1 = gets();
putf("Enter second number: ");
let num2 = gets();

if (type_of(num1) == "ERROR_OBJ" || type_of(num2) == "ERROR_OBJ") {
    putln("no input to read; this example needs a terminal");
    return;
}

let a, a_err = to_int(num1);
let b, b_err = to_int(num2);
if (a_err || b_err) {
    putln("please enter two whole numbers");
    return;
}

putf("Answer is: %d\n", sum(a, b));
