// Closures capture variables by reference; pmap workers get their own copy.

let sum_of = fn(xs) {
    let acc = 0;
    each(xs, fn(x) {
        acc = acc + x;
    });
    return acc;
};

let count_matching = fn(xs, keep) {
    let n = 0;
    each(xs, fn(x) {
        if (keep(x)) {
            n++;
        }
    });
    return n;
};

let is_even = fn(x) {
    return x % 2 == 0;
};
putf("sum_of([1,2,3,4])     = %d\n", sum_of([1, 2, 3, 4]));
putf("even count           = %d\n", count_matching([1, 2, 3, 4, 5, 6], is_even));

let make_counter = fn(start) {
    let n = start;
    return fn() {
        n++;
        return n;
    };
};

let ticket = make_counter(100);
putf("ticket()             = %d\n", ticket());
putf("ticket()             = %d\n", ticket());
let other = make_counter(100);
putf("a fresh counter      = %d\n", other());

let make_tally = fn() {
    let total = 0;
    let seen = 0;
    let add = fn(n) {
        total = total + n;
        seen++;
    };
    let mean = fn() {
        return total / seen;
    };
    return {"add": add, "mean": mean};
};

let tally = make_tally();
tally["add"](10);
tally["add"](20);
tally["add"](60);
putf("mean of 10,20,60     = %d\n", tally["mean"]());

// A closure made in a loop shares the loop variable; a parameter freezes it.
let freeze = fn(v) {
    return fn() {
        return v;
    };
};

let shared = [];
let frozen = [];
for (let i = 0; i < 3; i++) {
    shared = push(shared, fn() {
        return i;
    });
    frozen = push(frozen, freeze(i));
}
putf("shared               = [%d, %d, %d]\n", shared[0](), shared[1](), shared[2]());
putf("frozen               = [%d, %d, %d]\n", frozen[0](), frozen[1](), frozen[2]());

let sum_in_pmap = fn(xs) {
    let acc = 0;
    pmap(xs, fn(x) {
        acc = acc + x;
        return x;
    });
    return acc;
};

let doubled = pmap([1, 2, 3, 4], fn(x) {
    return x * 2;
});
let total = reduce(doubled, fn(a, b) {
    return a + b;
}, 0);
putf("accumulated in pmap  = %d\n", sum_in_pmap([1, 2, 3, 4]));
putf("returned from pmap   = %d\n", total);
