// Bitwise operators: masks, flag tests and shifts.

let READ = 1;
let WRITE = 2;
let EXEC = 4;

let perms = READ | EXEC;
putf("perms       = %d\n", perms);
putf("can read?   = %v\n", perms & READ != 0);
putf("can write?  = %v\n", perms & WRITE != 0);

perms = perms | WRITE;
putf("after set   = %d\n", perms);
perms = perms & ~EXEC;
putf("after clear = %d\n", perms);

let acc = 0;
acc |= READ;
acc |= WRITE;
acc ^= READ;
putf("acc         = %d\n", acc);

let b = 240;
putf("high nibble = %d\n", b >> 4);
putf("low nibble  = %d\n", b & 15);
putf("-8 >> 1     = %d\n", -8 >> 1);

let packed = 77 << 8 | 90;
putf("packed      = %d\n", packed);
putf("unpacked hi = %d\n", packed >> 8);
putf("unpacked lo = %d\n", packed & 255);

let popcount = fn(n) {
    let count = 0;
    for (let i = 0; i < 64; i++) {
        count += n >> i & 1;
    }
    return count;
};
putf("popcount(7)   = %d\n", popcount(7));
putf("popcount(240) = %d\n", popcount(240));
