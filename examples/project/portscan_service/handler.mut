// Per-connection handler that net_serve runs; standalone it prints a notice.
// mutant:sweep run -- calls serve_conn(), but checks for null and prints a notice standalone

let handle = fn() {
    let conn, _ = serve_conn();
    if (is_null(conn)) {
        putln("handler.mut run standalone (no connection). Launch via main.mut.");
        return false;
    }

    let banner, _ = serve_arg();
    let _, werr = net_conn_write(conn, banner + "\r\n", 2000);
    if (werr) {
        putln("[handler] write error:", werr);
    }

    let req, rerr = net_conn_read(conn, 1024, 2000);
    if (rerr) {
        putln("[handler] read error:", rerr);
    } else {
        putln("[handler] received", req["bytes"], "bytes");
    }

    let _, _ = net_conn_write(conn, "OK\r\n", 2000);
    let _, _ = net_conn_close(conn);
    return true;
};

handle();
