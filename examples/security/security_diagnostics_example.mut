// mutant:sweep needs-input -- reports this machine's debugger and VM state, which differs from host to host

putln("=== Security Diagnostics Example ===");
putln("Tip: run with --dev --security-log-level=debug (or --log-level=debug) to see detailed stderr logs.");
putln("");

let diagnostics, _ = security_diagnostics();
let debugger = diagnostics["debugger"];
let sandbox = diagnostics["sandbox"];

let print_items = fn(items) {
    if (len(items) == 0) {
        putln("  - none");
    }
    for (item in items) {
        putf("  - %s\n", item);
    }
};

putln("[Debugger]");
putf("detected: %t\n", debugger["detected"]);
putf("event_count: %d\n", debugger["event_count"]);
putf("method_count: %d\n", len(debugger["methods"]));
print_items(debugger["methods"]);

putln("");
putln("[Sandbox]");
putf("detected: %t\n", sandbox["detected"]);
putf("type: %s\n", sandbox["type"]);
putf("confidence: %d\n", sandbox["confidence"]);
putf("event_count: %d\n", sandbox["event_count"]);
putf("indicator_count: %d\n", len(sandbox["indicators"]));
print_items(sandbox["indicators"]);
if (sandbox["error"] != "") {
    putf("error: %s\n", sandbox["error"]);
}

putln("");
putln("Run this same script in Windows Terminal and PowerShell to compare outputs.");
