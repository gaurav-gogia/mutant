// mutant:sweep needs-input -- scores this machine's debugger and VM state, which differs from host to host

putln("=== Security Environment Forensics Report ===");

let output_directory = "example_output/security";
let report_path = output_directory + "/environment_report.json";

let created, _ = fs_mkdir(output_directory);
if (created == false) {
    putln("failed to create output directory");
}

let diagnostics, _ = security_diagnostics();
let debugger = diagnostics["debugger"];
let sandbox = diagnostics["sandbox"];

let risk_score = 0;
if (debugger["detected"]) {
    risk_score = risk_score + 40;
}
if (sandbox["detected"]) {
    risk_score = risk_score + sandbox["confidence"];
}
risk_score = risk_score + len(sandbox["indicators"]) * 5;
if (risk_score > 100) {
    risk_score = 100;
}

let severity = "low";
if (risk_score >= 40) {
    severity = "medium";
}
if (risk_score >= 70) {
    severity = "high";
}

putln("debugger detected: ", debugger["detected"]);
putln("sandbox detected: ", sandbox["detected"], " type=", sandbox["type"]);
putln("risk score: ", risk_score, " severity=", severity);

let report = {"profile": "environment_forensics", "risk_score": risk_score, "severity": severity, "debugger": debugger, "sandbox": sandbox};
let report_json, _ = json_stringify(report);
let written, _ = fs_write(report_path, report_json);
if (written) {
    putln("wrote report: ", report_path);
} else {
    putln("failed to write report");
}
