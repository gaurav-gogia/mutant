// Gate command execution behind a Rego policy, then run only what it allows.

let module = r"""
package cmd

default allow = false

allow {
  input.command == "whoami"
}

allow {
  input.command == "hostname"
}

decision = {"command": input.command, "allow": allow}
""";
let policy = {"module": module, "eval_query": "data.cmd.decision", "allow_query": "data.cmd.allow"};

let run = fn() {
    putln("=== command_sandbox ===");

    let _, err = policy_load("cmd_policy", policy);
    if (err) {
        putln("[error] policy_load:", err);
        return false;
    }

    for (cmd in ["whoami", "rm -rf /"]) {
        let allowed, err = policy_allow("cmd_policy", {"command": cmd});
        if (err) {
            putln("[error] policy_allow:", err);
            continue;
        }
        if (!allowed) {
            putln("policy DENIES:", cmd, "(not executed)");
            continue;
        }
        putln("policy ALLOWS:", cmd);
        let out, err = exec_string(cmd);
        if (err) {
            putln("  exec error:", err);
            continue;
        }
        // whoami prints this machine's account name, so show only that it printed one.
        putln("  exec ok:", out["ok"], "exit_code:", out["exit_code"], "timed_out:", out["timed_out"], "printed a name:", len(out["stdout"]) > 0);
    }

    let builder, err = cmd_builder();
    if (!err) {
        let _, _ = cmd_add(builder, "echo");
        putln("built a command via cmd_builder (guarded by the same policy at run time)");
    }
    return true;
};

run();
