// Reads PE header fields from a Windows sample with the bytes_* builtins.
putln("=== bytes_cursor_sample_demo ===");
putln("Safe use: reads static metadata from examples/data/sample_win.exe");

let fail = fn(err, op) {
    if (err) {
        putln("[error]", op, ":", err);
        return true;
    }
    return false;
};

let output_dir = "example_output/bytes_cursor_sample_demo";
let report_path = output_dir + "/report_win.json";
let sample_path = "examples/data/sample_win.exe";

let made, err = fs_mkdir(output_dir);
fail(err, "fs_mkdir");
if (made == false) {
    putln("failed to create output directory");
}

let data, err = fs_read(sample_path);
if (fail(err, "fs_read sample")) {
    return;
}
let size, err = bytes_len(data);
if (fail(err, "bytes_len sample")) {
    return;
}
let first16, err = bytes_slice(data, 0, 16);
if (fail(err, "bytes_slice first16")) {
    return;
}

let b1, _ = bytes_get(first16, 0);
let b2, _ = bytes_get(first16, 1);
let dos_magic = "";
if (b1 == 77 && b2 == 90) {
    dos_magic = "MZ";
}

let pe_offset, err = bytes_read_u32_le(data, 60);
if (fail(err, "bytes_read_u32_le e_lfanew")) {
    return;
}
let signature, err = bytes_read_u32_le(data, pe_offset);
if (fail(err, "bytes_read_u32_le pe signature")) {
    return;
}
let machine, err = bytes_read_u16_le(data, pe_offset + 4);
if (fail(err, "bytes_read_u16_le machine")) {
    return;
}
let section_count, err = bytes_read_u16_le(data, pe_offset + 6);
if (fail(err, "bytes_read_u16_le section count")) {
    return;
}
let optional_magic, err = bytes_read_u16_le(data, pe_offset + 24);
if (fail(err, "bytes_read_u16_le optional magic")) {
    return;
}

let signature_hex, _ = bytes_hex(signature, 8);
let machine_hex, _ = bytes_hex(machine, 4);
let optional_magic_hex, _ = bytes_hex(optional_magic, 4);

let first16_hex = "";
for (let i = 0; i < 16; i = i + 1) {
    let b, _ = bytes_get(first16, i);
    let h, _ = bytes_hex(b, 2);
    if (i > 0) {
        first16_hex = first16_hex + " ";
    }
    first16_hex = first16_hex + h;
}

putln("sample bytes: ", size);
putln("dos magic: ", dos_magic);
putln("pe offset: ", pe_offset);
putln("pe signature: ", signature_hex);
putf("machine: %s sections: %d\n", machine_hex, section_count);
putln("optional magic: ", optional_magic_hex);
putln("first16: ", first16_hex);

let report = {"profile": "bytes_cursor_sample_demo", "sample_path": sample_path, "format": "pe_like", "byte_length": size, "dos_magic": dos_magic, "pe_offset": pe_offset, "pe_signature_hex": signature_hex, "machine_hex": machine_hex, "section_count": section_count, "optional_magic_hex": optional_magic_hex, "first16_hex": first16_hex};
let report_json, err = json_stringify(report);
if (fail(err, "json_stringify report")) {
    return;
}
let written, err = fs_write(report_path, report_json);
if (fail(err, "fs_write report")) {
    return;
}
if (written) {
    putln("wrote report: ", report_path);
} else {
    putln("failed to write report");
}
