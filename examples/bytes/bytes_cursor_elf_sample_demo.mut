// Reads ELF header fields from a Linux sample with the bytes_* builtins.
putln("=== bytes_cursor_elf_sample_demo ===");
putln("Safe use: reads static metadata from examples/data/sample_lnx");

let fail = fn(err, op) {
    if (err) {
        putln("[error]", op, ":", err);
        return true;
    }
    return false;
};

let output_dir = "example_output/bytes_cursor_sample_demo";
let report_path = output_dir + "/report_lnx.json";
let sample_path = "examples/data/sample_lnx";

let made, err = fs_mkdir(output_dir);
fail(err, "fs_mkdir");
if (made == false) {
    putln("failed to create output directory");
}

let data, err = fs_read(sample_path);
if (fail(err, "fs_read sample")) {
    return;
}
let size, err = bytes_len(data);
if (fail(err, "bytes_len sample")) {
    return;
}
let first16, err = bytes_slice(data, 0, 16);
if (fail(err, "bytes_slice first16")) {
    return;
}

let b1, _ = bytes_get(first16, 0);
let b2, _ = bytes_get(first16, 1);
let b3, _ = bytes_get(first16, 2);
let b4, _ = bytes_get(first16, 3);
let elf_class, _ = bytes_get(first16, 4);
let elf_endian, _ = bytes_get(first16, 5);
let magic = "";
if (b1 == 127 && b2 == 69 && b3 == 76 && b4 == 70) {
    magic = "ELF";
}

let machine, err = bytes_read_u16_le(data, 18);
if (fail(err, "bytes_read_u16_le machine")) {
    return;
}
let entry, err = bytes_read_u64_le(data, 24);
if (fail(err, "bytes_read_u64_le entry")) {
    return;
}
if (elf_endian == 2) {
    let machine_be, _ = bytes_read_u16_be(data, 18);
    let entry_be, _ = bytes_read_u64_be(data, 24);
    machine = machine_be;
    entry = entry_be;
}

let entry_width = 16;
if (elf_class != 2) {
    entry_width = 8;
}
let machine_hex, _ = bytes_hex(machine, 4);
let entry_hex, _ = bytes_hex(entry, entry_width);

let first16_hex = "";
for (let i = 0; i < 16; i = i + 1) {
    let b, _ = bytes_get(first16, i);
    let h, _ = bytes_hex(b, 2);
    if (i > 0) {
        first16_hex = first16_hex + " ";
    }
    first16_hex = first16_hex + h;
}

putf("sample bytes: %d\n", size);
putf("magic: %s\n", magic);
putf("elf class: %d endian: %d machine: %s\n", elf_class, elf_endian, machine_hex);
putf("entry: %s\n", entry_hex);
putf("first16: %s\n", first16_hex);

let report = {"profile": "bytes_cursor_elf_sample_demo", "sample_path": sample_path, "format": "elf_like", "magic": magic, "byte_length": size, "elf_class": elf_class, "elf_endian": elf_endian, "machine_hex": machine_hex, "entry_hex": entry_hex, "first16_hex": first16_hex};
let report_json, err = json_stringify(report);
if (fail(err, "json_stringify report")) {
    return;
}
let written, err = fs_write(report_path, report_json);
if (fail(err, "fs_write report")) {
    return;
}
if (written) {
    putf("wrote report: %s\n", report_path);
} else {
    putln("failed to write report");
}
