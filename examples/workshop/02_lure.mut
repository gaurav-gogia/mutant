import "lib/quilldrop.mut";

putln("QUILLDROP 2/10  the lure");

let lure = quilldrop.path("Users/clerk/Inbox/invoice.eml");

if (quilldrop.ready(quilldrop.root) && quilldrop.ready(lure)) {
    let raw, _ = fs_read(lure);
    let msg, _ = email_parse(raw);
    putln("  from", msg["from"]);
    putln("  subject", msg["subject"]);
    putln("  links", extract_iocs(msg["text"])["urls"]);
    for (a in msg["attachments"]) {
        putln("  attached", a["filename"]);
    }
}
