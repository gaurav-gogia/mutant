// Seeds sample events, scores each one and writes the findings to a report.
putln("=== IOC Event Triage ===");

let output_dir = "example_output/ioc";
let events_path = output_dir + "/events.json";
let report_path = output_dir + "/ioc_triage_report.json";

let made, _ = fs_mkdir(output_dir);
if (made == false) {
    putln("failed to create output directory");
}

let exists, _ = fs_exists(events_path);
if (exists == false) {
    let lua = "return [[{\"events\":[{\"src\":\"10.10.10.5\",\"event\":\"login_failed\",\"count\":6},{\"src\":\"10.10.10.5\",\"event\":\"login_failed\",\"count\":5},{\"src\":\"10.10.10.9\",\"event\":\"powershell_encoded\",\"count\":1},{\"src\":\"10.10.10.11\",\"event\":\"service_install\",\"count\":2}]}]]";
    let sample, err = lua_run_string(lua);
    if (err) {
        putln("[error] lua_run_string sample: ", err);
    }
    if (sample["ok"] == false) {
        putln("failed to generate sample events: ", sample["error"]);
        return;
    }
    let seeded, err = fs_write(events_path, sample["result"]);
    if (err) {
        putln("[error] fs_write sample: ", err);
    }
    if (seeded) {
        putln("seeded sample events at ", events_path);
    }
}

let source, err = fs_read(events_path);
if (err) {
    putln("[error] fs_read input: ", err);
    return;
}
let parsed, err = json_parse(source);
if (err) {
    putln("[error] json_parse input: ", err);
    return;
}
let events = parsed["events"];

let findings = [];
let high = 0;
let medium = 0;
for (ev in events) {
    let score = 10;
    if (ev["event"] == "auth_fail") {
        score = 25;
        if (ev["count"] > 4) {
            score = 65;
        }
    }
    if (ev["event"] == "powershell_encoded") {
        score = 95;
    }
    if (ev["event"] == "service_install") {
        score = 70;
    }

    let severity = "low";
    if (score > 79) {
        severity = "high";
        high = high + 1;
    } else {
        if (score > 49) {
            severity = "medium";
            medium = medium + 1;
        }
    }
    if (severity != "low") {
        findings = push(findings, {"src": ev["src"], "event": ev["event"], "count": ev["count"], "score": score, "severity": severity});
    }
}

putln("events processed: ", len(events));
putln("high findings: ", high, " medium findings: ", medium);

let report = {"profile": "ioc_event_triage", "input_file": events_path, "events_processed": len(events), "high_findings": high, "medium_findings": medium, "findings": findings};
let report_json, _ = json_stringify(report);
let written, _ = fs_write(report_path, report_json);
if (written) {
    putln("wrote report: ", report_path);
} else {
    putln("failed to write report");
}
