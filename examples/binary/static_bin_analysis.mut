// Reads PE headers, sections and imports from a sample without running it.
putln("=== static_binary_metadata_extractor ===");
putln("Safe use: static metadata only. No execution performed.");

struct ParseState { data; last; sections; pointer_size; }

let fail = fn(err, op) {
    if (err) {
        putln("[error]", op, ":", err);
        return true;
    }
    return false;
};

let hex = fn(value, width) {
    let text, _ = bytes_hex(value, width);
    return text;
};

let read_bytes = fn(data, offset, what) {
    let out = [];
    for (let i = 0; i < 4; i = i + 1) {
        let b, err = bytes_get(data, offset + i);
        if (fail(err, "bytes_get " + what)) {
            return [];
        }
        out = push(out, b);
    }
    return out;
};

let hex_bytes = fn(list) {
    let text = "";
    for (b in list) {
        let pair, _ = bytes_slice(hex(b, 2), 2, 2);
        text = text + pair;
    }
    return text;
};

let rva_to_raw = fn(state, rva) {
    for (sec in state.sections) {
        let size = sec["vsize"];
        if (sec["raw_size"] > size) {
            size = sec["raw_size"];
        }
        if (rva >= sec["vaddr"] && rva < sec["vaddr"] + size) {
            return sec["raw_ptr"] + rva - sec["vaddr"];
        }
    }
    return 0;
};

let parse_thunks = fn(state, thunk_rva) {
    let raw = rva_to_raw(state, thunk_rva);
    if (raw == 0) {
        return {"has_thunks": false, "function_count": 0, "ordinal_count": 0, "functions": [], "function_details": []};
    }

    let width = state.pointer_size;
    let count = 0;
    let ordinals = 0;
    let functions = [];
    let details = [];
    for (let i = 0; i < 8192; i = i + 1) {
        let slot = raw + i * width;
        if (slot + width - 1 > state.last) {
            break;
        }
        let lo, _ = bytes_read_u32_le(state.data, slot);
        let flags = lo;
        if (width == 8) {
            let hi, _ = bytes_read_u32_le(state.data, slot + 4);
            flags = hi;
        }
        if (lo == 0 && flags == 0) {
            break;
        }

        count = count + 1;
        let entry = hex(thunk_rva + i * width, 8);
        if (flags > 2147483647) {
            ordinals = ordinals + 1;
            details = push(details, {"by_ordinal": true, "ordinal": lo % 65536, "hint": 0, "name": "", "thunk_rva": entry});
            continue;
        }

        let name_raw = rva_to_raw(state, lo);
        if (name_raw == 0) {
            continue;
        }
        let hint, err = bytes_read_u16_le(state.data, name_raw);
        if (fail(err, "bytes_read_u16_le hint")) {
            break;
        }
        let name, err = bytes_cstr_at(state.data, name_raw + 2, 256);
        if (fail(err, "bytes_cstr_at fn_name")) {
            break;
        }
        if (name != "") {
            functions = push(functions, name);
        }
        details = push(details, {"by_ordinal": false, "ordinal": 0, "hint": hint, "name": name, "thunk_rva": entry});
    }

    return {"has_thunks": true, "function_count": count, "ordinal_count": ordinals, "functions": functions, "function_details": details};
};

let parse_sections = fn(data, last, base, count) {
    let table = [];
    let runtime = [];
    for (let i = 0; i < count; i = i + 1) {
        let at = base + i * 40;
        if (at + 39 > last) {
            continue;
        }
        let name, _ = bytes_cstr_at(data, at, 8);
        let vsize, _ = bytes_read_u32_le(data, at + 8);
        let vaddr, _ = bytes_read_u32_le(data, at + 12);
        let raw_size, _ = bytes_read_u32_le(data, at + 16);
        let raw_ptr, _ = bytes_read_u32_le(data, at + 20);
        let flags, _ = bytes_read_u32_le(data, at + 36);

        table = push(table, {"index": i, "name": name, "virtual_size": vsize, "virtual_address": hex(vaddr, 8), "raw_size": raw_size, "raw_ptr": hex(raw_ptr, 8), "characteristics": hex(flags, 8)});
        runtime = push(runtime, {"vsize": vsize, "vaddr": vaddr, "raw_size": raw_size, "raw_ptr": raw_ptr});
    }
    return {"table": table, "runtime": runtime};
};

let parse_imports = fn(state, dir_raw) {
    let seen = 0;
    let named = 0;
    let with_thunks = 0;
    let table = [];
    for (let i = 0; i < 512; i = i + 1) {
        let d = dir_raw + i * 20;
        if (d + 19 > state.last) {
            break;
        }
        let oft, _ = bytes_read_u32_le(state.data, d);
        let name_rva, _ = bytes_read_u32_le(state.data, d + 12);
        let ft, _ = bytes_read_u32_le(state.data, d + 16);
        if (oft + name_rva + ft == 0) {
            break;
        }
        seen = seen + 1;

        let name_raw = 0;
        if (name_rva > 0) {
            name_raw = rva_to_raw(state, name_rva);
        }
        let dll = "";
        if (name_raw > 0) {
            let name, err = bytes_cstr_at(state.data, name_raw, 256);
            if (fail(err, "bytes_cstr_at dll")) {
                return {"ok": false};
            }
            dll = name;
        }
        if (dll != "") {
            named = named + 1;
        }

        let thunk_rva = oft;
        if (thunk_rva == 0) {
            thunk_rva = ft;
        }
        let thunks = parse_thunks(state, thunk_rva);
        if (thunks["has_thunks"]) {
            with_thunks = with_thunks + 1;
        }
        if (dll == "" && thunks["function_count"] == 0) {
            continue;
        }

        table = push(table, {"dll": dll, "function_count": thunks["function_count"], "ordinal_count": thunks["ordinal_count"], "functions": thunks["functions"], "function_details": thunks["function_details"]});
    }

    return {"ok": true, "descriptors_seen": seen, "descriptors_with_name": named, "descriptors_with_thunks": with_thunks, "import_table": table};
};

let output_dir = "example_output/static_binary_metadata_extractor";
let sample_path = "examples/data/sample_win.exe";
let report_path = output_dir + "/report.json";

let made, err = fs_mkdir(output_dir);
if (fail(err, "fs_mkdir")) {
    return;
}
if (made == false) {
    putln("failed to create output directory");
}

let data, err = fs_read(sample_path);
if (fail(err, "fs_read sample")) {
    return;
}
let size, err = bytes_len(data);
if (fail(err, "bytes_len sample")) {
    return;
}
let last = size - 1;

let magic = read_bytes(data, 0, "magic");
if (len(magic) == 0) {
    return;
}
let format = "unknown";
if (magic[0] == 77 && magic[1] == 90) {
    format = "pe_like";
}
if (magic[0] == 127 && magic[1] == 69 && magic[2] == 76 && magic[3] == 70) {
    format = "elf_like";
}

let pe_ok = false;
let pe_offset = 0;
let pe_signature = "";
let machine = "";
let sections = 0;
let timestamp = 0;
let characteristics = "";
let optional_magic = "";
let entry_rva = 0;
let pointer_size = 0;
let data_directory_base = 0;
let import_directory_rva = 0;
let import_directory_raw = 0;
let section_table = [];
let imports = {"ok": true, "descriptors_seen": 0, "descriptors_with_name": 0, "descriptors_with_thunks": 0, "import_table": []};

if (format == "pe_like" && size >= 64) {
    let offset, err = bytes_read_u32_le(data, 60);
    if (fail(err, "bytes_read_u32_le e_lfanew")) {
        return;
    }
    pe_offset = offset;
    let signature = read_bytes(data, pe_offset, "pe signature");
    if (len(signature) == 0) {
        return;
    }
    pe_signature = hex_bytes(signature);
    pe_ok = signature[0] == 80 && signature[1] == 69;
}

if (pe_ok) {
    let header = pe_offset + 4;
    let count, err = bytes_read_u16_le(data, header + 2);
    if (fail(err, "bytes_read_u16_le sections")) {
        return;
    }
    sections = count;
    if (sections > 128) {
        sections = 128;
    }

    let machine_raw, err = bytes_read_u16_le(data, header);
    if (fail(err, "bytes_read_u16_le machine")) {
        return;
    }
    machine = hex(machine_raw, 4);

    let stamp, err = bytes_read_u32_le(data, header + 4);
    if (fail(err, "bytes_read_u32_le timestamp")) {
        return;
    }
    timestamp = stamp;

    let flags, err = bytes_read_u16_le(data, header + 18);
    if (fail(err, "bytes_read_u16_le characteristics")) {
        return;
    }
    characteristics = hex(flags, 4);

    let optional_size, err = bytes_read_u16_le(data, header + 16);
    if (fail(err, "bytes_read_u16_le size_of_optional_header")) {
        return;
    }

    let optional = header + 20;
    let magic_raw, err = bytes_read_u16_le(data, optional);
    if (fail(err, "bytes_read_u16_le optional_magic")) {
        return;
    }
    optional_magic = hex(magic_raw, 4);

    let entry, err = bytes_read_u32_le(data, optional + 16);
    if (fail(err, "bytes_read_u32_le entry_rva")) {
        return;
    }
    entry_rva = entry;

    pointer_size = 4;
    data_directory_base = optional + 96;
    if (magic_raw == 523) {
        pointer_size = 8;
        data_directory_base = optional + 112;
    }

    let parsed = parse_sections(data, last, optional + optional_size, sections);
    section_table = parsed["table"];

    let dir_rva, err = bytes_read_u32_le(data, data_directory_base + 8);
    if (fail(err, "bytes_read_u32_le import_directory_rva")) {
        return;
    }
    import_directory_rva = dir_rva;

    let state = ParseState {data: data, last: last, sections: parsed["runtime"], pointer_size: pointer_size};
    import_directory_raw = rva_to_raw(state, import_directory_rva);
    if (import_directory_rva != 0 && import_directory_raw != 0) {
        imports = parse_imports(state, import_directory_raw);
    }
}

if (imports["ok"] == false) {
    return;
}

let metadata = {"format": format, "magic_hex": hex_bytes(magic), "byte_length": size, "pe_offset": pe_offset, "pe_signature": pe_signature, "machine": machine, "sections": sections, "timestamp": timestamp, "characteristics": characteristics, "optional_magic": optional_magic, "entry_rva": entry_rva, "section_table": section_table};
let diagnostics = {"pe_ok": pe_ok, "pe_offset": pe_offset, "import_directory_rva": hex(import_directory_rva, 8), "import_directory_raw": hex(import_directory_raw, 8), "data_directory_base": hex(data_directory_base, 8), "pointer_size": pointer_size, "descriptors_seen": imports["descriptors_seen"], "descriptors_with_name": imports["descriptors_with_name"], "descriptors_with_thunks": imports["descriptors_with_thunks"]};
let report = {"metadata": metadata, "import_table": imports["import_table"], "import_diagnostics": diagnostics};

let report_json, err = json_stringify(report);
if (fail(err, "json_stringify bundle")) {
    return;
}
let written, err = fs_write(report_path, report_json);
if (fail(err, "fs_write report")) {
    return;
}
if (written) {
    putln("wrote report: " + report_path);
} else {
    putln("failed to write report");
}
