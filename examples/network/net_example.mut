// Resolves a host name with net_resolve and probes a TCP port with net_dial.
// mutant:sweep needs-input -- resolves and dials example.com over the internet

putln("=== DNS Resolution ===");
let addrs, err = net_resolve("example.com");
if (err) {
    putln("could not resolve: ", err);
} else {
    putln("example.com resolves to:");
    for (addr in addrs) {
        putln("  ", addr);
    }
}

putln("");
putln("=== TCP Dial ===");
let result, _ = net_dial("example.com:80", 1000);
if (result["ok"]) {
    putln("connected to example.com in ", result["latency_ms"], "ms");
} else {
    putln("could not connect (expected if nothing is listening): ", result["error"]);
    putln("latency measured: ", result["latency_ms"], "ms");
}
