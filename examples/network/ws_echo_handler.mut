// Per-connection handler for ws_echo_server.mut: completes the WebSocket handshake, then echoes frames.
// mutant:sweep serve-handler -- net_serve dispatches this; standalone it has no connection to read

let conn, _ = serve_conn();

let req, _ = http_conn_read_request(conn, 10000);
let accept, _ = ws_accept_key(req["headers"]["Sec-Websocket-Key"]);
let handshake = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n";
net_conn_write(conn, handshake);

// Opcodes: 1 text, 2 binary, 8 close, 9 ping, 10 pong. Server frames go out unmasked.
for (let i = 0; i < 100000; i++) {
    let frame, err = ws_read_frame(conn, 30000);
    if (err) {
        break;
    }
    let op = frame["opcode"];
    if (op == 8) {
        ws_write_frame(conn, 8, "", false);
        break;
    }
    if (op == 9) {
        ws_write_frame(conn, 10, frame["payload"], false);
        continue;
    }
    ws_write_frame(conn, op, "echo:" + frame["payload"], false);
}
net_conn_close(conn);
