// Resolves hosts, probes common ports, and records open services in a graph and a JSON report.
// mutant:sweep needs-input -- resolves and dials example.com and cloudflare.com over the internet

let warn = fn(op, err) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

let add_node = fn(db, kind, props) {
    let node, err = db_add_node(db, kind);
    warn("db_add_node", err);
    for (key, value in props) {
        let _, err = db_index_prop(db, node, key, value);
        warn("db_index_prop", err);
    }
    return node;
};

putln("=== Network Service Recon + Graph Artifact ===");

let out_dir = "example_output/recon";
let graph_path = out_dir + "/service_graph";
let report_path = out_dir + "/network_recon_report.json";

let _, err = fs_mkdir(out_dir);
if (err) {
    putln("failed to create output directory: ", err);
}

let target_hosts = ["example.com", "cloudflare.com"];
let target_ports = ["80", "443", "22", "3389"];

let NODE_HOST = 1;
let NODE_SERVICE = 2;
let EDGE_EXPOSES = 1;

let db, err = db_open_disk(graph_path);
warn("db_open_disk", err);

let host_nodes = [];
let findings = [];
for (host in target_hosts) {
    let host_node = add_node(db, NODE_HOST, {"host": host});
    host_nodes = push(host_nodes, host_node);

    let resolved, err = net_resolve(host);
    warn("net_resolve", err);
    if (!err && len(resolved) > 0) {
        let _, err = db_index_prop(db, host_node, "resolved_ip", resolved[0]);
        warn("db_index_prop", err);
    }

    for (port in target_ports) {
        let dial, _ = net_dial(host + ":" + port, 1200);
        if (!dial["ok"]) {
            continue;
        }
        putln("open: ", host, ":", port, " latency_ms=", dial["latency_ms"]);

        let service_node = add_node(db, NODE_SERVICE, {"port": port, "latency_ms": to_string(dial["latency_ms"])});
        let _, err = db_add_edge(db, host_node, service_node, EDGE_EXPOSES);
        warn("db_add_edge", err);

        findings = push(findings, {"host": host, "port": port, "latency_ms": dial["latency_ms"], "status": "open"});
    }
}

let stats, err = db_stats(db);
warn("db_stats", err);

let bfs_node_count = 0;
if (len(host_nodes) > 0) {
    let bfs, err = db_bfs(db, first(host_nodes), 1, "out");
    warn("db_bfs", err);
    bfs_node_count = len(bfs["nodes"]);
}

let _, err = db_close(db);
warn("db_close", err);

let report = {"profile": "network_recon_graph", "targets": target_hosts, "open_service_count": len(findings), "graph_stats": stats, "bfs_node_count": bfs_node_count, "findings": findings};
let report_json, err = json_stringify(report);
warn("json_stringify", err);
let _, err = fs_write(report_path, report_json);
if (err) {
    putln("failed to write report: ", err);
} else {
    putln("wrote report: ", report_path);
    putln("graph path: ", graph_path);
}
