// A TLS echo server with a self-signed certificate; test with: openssl s_client -connect 127.0.0.1:8443
// mutant:sweep server -- binds 127.0.0.1:8443 over TLS and serves until interrupted

let echo = fn(client) {
    // err is for a bad handle; I/O failures and timeouts land in msg["error"].
    let msg, err = net_conn_read(client, 4096, 15000);
    if (err) {
        putln("read failed: ", err);
        return false;
    }
    if (msg["error"] != "") {
        putln("read error: ", msg["error"]);
        return false;
    }
    if (msg["bytes"] == 0) {
        putln("client sent nothing (eof: ", msg["eof"], ")");
        return false;
    }
    let _, err = net_conn_write(client, "echo: " + msg["data"]);
    if (err) {
        putln("write failed: ", err);
        return false;
    }
    return true;
};

let serve = fn(bind_addr) {
    let cert_opts = {"common_name": "localhost", "dns_names": ["localhost"], "ip_addresses": ["127.0.0.1"]};
    let cert, err = tls_generate_cert(cert_opts);
    if (err) {
        putln("cert generation failed: ", err);
        return false;
    }

    let ln, err = net_tls_listen(bind_addr, cert["cert_pem"], cert["key_pem"], {"min_version": "1.2"});
    if (err) {
        putln("listen failed: ", err);
        return false;
    }
    putln("secure echo server listening on ", bind_addr);

    while (true) {
        let acc, _ = net_accept(ln, 0);
        if (!acc["ok"]) {
            continue;
        }
        putln("client connected: ", acc["remote_addr"]);
        echo(acc["handle"]);
        net_conn_close(acc["handle"]);
    }
    return true;
};

serve("127.0.0.1:8443");
