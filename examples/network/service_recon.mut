// Resolves a host, connect-scans a small port range, and grabs a banner, all on localhost.
// mutant:sweep needs-input -- scans ports on this machine, and which are open differs from host to host

putln("=== service_recon ===");

let host = "127.0.0.1";

let addrs, err = net_resolve(host);
if (err) {
    putln("[error] net_resolve:", err);
} else {
    putln("resolved", host, "->", addrs);
}

let scan, err = net_connect_scan(host, 78, 82, 200);
if (err) {
    putln("[error] net_connect_scan:", err);
} else {
    putln("scanned", scan["scanned"], "ports; open:", scan["open_ports"]);
}

let banner, _ = net_banner(host + ":80", 300);
if (banner["ok"]) {
    putln("banner:", banner["banner"]);
} else {
    putln("no banner on :80 (expected when nothing is listening):", banner["error"]);
}
