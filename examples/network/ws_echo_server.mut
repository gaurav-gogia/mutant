// A concurrent WebSocket echo server: net_serve runs ws_echo_handler.mut for each connection.
// mutant:sweep server -- binds 127.0.0.1:8140 and serves until interrupted

let ln, err = net_listen("127.0.0.1:8140");
if (err) {
    putln("listen failed: ", err);
} else {
    putln("websocket echo server on ws://127.0.0.1:8140/");
    let _, err = net_serve(ln, "examples/network/ws_echo_handler.mut", "");
    putln("serve ended: ", err);
}
