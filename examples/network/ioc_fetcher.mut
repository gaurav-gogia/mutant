// Downloads a public IOC feed, extracts the first 200 domains with Lua, and records them in a graph and a JSON report.
// mutant:sweep needs-input -- downloads a public IOC feed from raw.githubusercontent.com

let warn = fn(op, err) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

let add_node = fn(db, kind, props) {
    let node, err = db_add_node(db, kind);
    warn("db_add_node", err);
    for (key, value in props) {
        let _, err = db_index_prop(db, node, key, value);
        warn("db_index_prop", err);
    }
    return node;
};

putln("=== ioc_fetcher ===");
putln("Safe use: downloads public IOC feed for defensive filtering.");

let out_dir = "example_output/ioc_fetcher";
let input_path = out_dir + "/source.json";
let feed_path = out_dir + "/ioc_feed.txt";
let graph_path = out_dir + "/ioc_graph";
let report_path = out_dir + "/report.json";

let _, err = fs_mkdir(out_dir);
if (err) {
    putln("failed to create output directory: ", err);
}

let exists, err = fs_exists(input_path);
warn("fs_exists", err);
if (!exists) {
    let seed = {"ioc_api": "https://raw.githubusercontent.com/mitchellkrogza/Phishing.Database/master/phishing-domains-ACTIVE.txt"};
    let seed_json, err = json_stringify(seed);
    warn("json_stringify", err);
    let _, err = fs_write(input_path, seed_json);
    if (err) {
        putln("failed to seed dataset: ", err);
    } else {
        putln("seeded test dataset: ", input_path);
    }
}

let input_json, err = fs_read(input_path);
warn("fs_read", err);
let source, err = json_parse(input_json);
warn("json_parse", err);
let api = source["ioc_api"];

let response, err = http_get(api);
warn("http_get", err);
let _, err = fs_write(feed_path, response["body"]);
warn("fs_write feed", err);

// A ' or \ in the path would break out of the Lua string it is spliced into.
let lua_path = text_replace(text_replace(feed_path, "'", ""), "\\", "");
let lua_extract = "local data,err=mutant.read_file('" + lua_path + "'); if not data then return '[]' end; local q=string.char(34); local out={}; local count=0; for line in string.gmatch(data, '[^\\n]+') do line=string.gsub(line,'\\r',''); if line ~= '' then table.insert(out,q..line..q); count=count+1; if count >= 200 then break end end end; return '['..table.concat(out,',')..']'";
let lua_result, err = lua_run_string(lua_extract);
warn("lua_run_string", err);
let iocs, err = json_parse(lua_result["result"]);
warn("json_parse iocs", err);

let NODE_FEED = 1;
let NODE_IOC = 2;
let EDGE_CONTAINS = 1;

let db, err = db_open_disk(graph_path);
warn("db_open_disk", err);
let feed_node = add_node(db, NODE_FEED, {"source": api});
for (ioc in iocs) {
    let ioc_node = add_node(db, NODE_IOC, {"value": ioc, "kind": "domain"});
    let _, err = db_add_edge(db, feed_node, ioc_node, EDGE_CONTAINS);
    warn("db_add_edge", err);
}

let stats, err = db_stats(db);
warn("db_stats", err);
let _, err = db_close(db);
warn("db_close", err);

let report = {"profile": "ioc_fetcher", "source": api, "feed_file": feed_path, "iocs_loaded": len(iocs), "graph_path": graph_path, "graph_stats": stats, "http_status": response["status"], "http_error": response["error"]};
let report_json, err = json_stringify(report);
warn("json_stringify", err);
let _, err = fs_write(report_path, report_json);
if (err) {
    putln("failed to write report: ", err);
} else {
    putln("wrote report: ", report_path);
}
