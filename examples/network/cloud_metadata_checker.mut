// Checks cloud metadata endpoints (opt-in) and records the results in a graph and a JSON report.

let warn = fn(op, err) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

let add_node = fn(db, kind, props) {
    let node, err = db_add_node(db, kind);
    warn("db_add_node", err);
    for (key, value in props) {
        let _, err = db_index_prop(db, node, key, value);
        warn("db_index_prop", err);
    }
    return node;
};

putln("=== cloud_metadata_checker ===");
putln("Safe default: metadata checks are opt-in via config allow_sensitive_endpoints=true.");

let out_dir = "example_output/cloud_metadata_checker";
let input_path = out_dir + "/metadata_targets.json";
let graph_path = out_dir + "/metadata_graph";
let report_path = out_dir + "/report.json";
let google_endpoint = "http://metadata.google.internal/computeMetadata/v1/";

let _, err = fs_mkdir(out_dir);
if (err) {
    putln("failed to create output directory: ", err);
}

let exists, err = fs_exists(input_path);
warn("fs_exists", err);
if (!exists) {
    let seed = {"allow_sensitive_endpoints": false, "metadata_endpoints": ["http://169.254.169.254/latest/meta-data/", google_endpoint]};
    let seed_json, err = json_stringify(seed);
    warn("json_stringify", err);
    let _, err = fs_write(input_path, seed_json);
    if (err) {
        putln("failed to seed dataset: ", err);
    } else {
        putln("seeded test dataset: ", input_path);
    }
}

let input_json, err = fs_read(input_path);
warn("fs_read", err);
let config, err = json_parse(input_json);
warn("json_parse", err);
let allow_sensitive = config["allow_sensitive_endpoints"];

let NODE_ENDPOINT = 1;
let NODE_RESULT = 2;
let EDGE_CHECKED = 1;

let db, err = db_open_disk(graph_path);
warn("db_open_disk", err);

let results = [];
for (i, endpoint in config["metadata_endpoints"]) {
    let resp = {"status": 0, "error": "skipped_by_default", "body": ""};
    if (allow_sensitive && endpoint == google_endpoint) {
        let reply, err = http_request("GET", endpoint, "", {"Metadata-Flavor": "Google"});
        warn("http_request", err);
        resp = reply;
    }
    if (allow_sensitive && endpoint != google_endpoint) {
        let reply, err = http_get(endpoint);
        warn("http_get", err);
        resp = reply;
    }

    let endpoint_node = add_node(db, NODE_ENDPOINT, {"url": endpoint});
    let result_node = add_node(db, NODE_RESULT, {"status": to_string(resp["status"]), "error": resp["error"], "allow_sensitive": to_string(allow_sensitive)});
    let _, err = db_add_edge(db, endpoint_node, result_node, EDGE_CHECKED);
    warn("db_add_edge", err);

    results = push(results, {"endpoint_index": i, "endpoint": endpoint, "status": resp["status"], "error": resp["error"], "body_preview": resp["body"]});
}

let stats, err = db_stats(db);
warn("db_stats", err);
let _, err = db_close(db);
warn("db_close", err);

let report = {"profile": "cloud_metadata_checker", "input_file": input_path, "allow_sensitive_endpoints": allow_sensitive, "endpoints_checked": len(results), "graph_path": graph_path, "graph_stats": stats, "results": results};
let report_json, err = json_stringify(report);
warn("json_stringify", err);
let _, err = fs_write(report_path, report_json);
if (err) {
    putln("failed to write report: ", err);
} else {
    putln("wrote report: ", report_path);
}
