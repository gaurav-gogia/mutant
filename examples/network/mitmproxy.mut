// An HTTP/HTTPS intercepting proxy on 127.0.0.1:8080 that decrypts HTTPS with per-host certificates from a local CA.
// mutant:sweep server -- binds 127.0.0.1:8080 and proxies until interrupted

let BAD_GATEWAY = "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n";

// The last ":" introduces the port; a bare IPv6 address such as "[::1]" has none.
let split_authority = fn(authority) {
    let parts = text_split(authority, ":");
    if (len(parts) < 2) {
        return {"host": authority, "port": ""};
    }
    let port = parts[len(parts) - 1];
    if (text_contains(port, "]")) {
        return {"host": authority, "port": ""};
    }
    return {"host": str_trim_suffix(authority, ":" + port), "port": port};
};

// The answer to a HEAD request carries no body, so the reason goes in a header.
let proxy_error = fn(method, reason) {
    if (method == "HEAD") {
        return {"status": 502, "body": "", "headers": {"X-Mutant-Proxy": reason}};
    }
    return {"status": 502, "body": "mutant-proxy: " + reason, "headers": {}};
};

// relay forwards request to addr, over TLS when server_name is set, and returns the response.
let relay = fn(addr, server_name, request) {
    let method = request["method"];
    let upstream, err = net_connect(addr, 8000);
    if (err) {
        return proxy_error(method, "upstream connect failed");
    }
    if (server_name != "") {
        let _, err = net_tls_upgrade_client(upstream, {"server_name": server_name});
        if (err) {
            net_conn_close(upstream);
            return proxy_error(method, "upstream TLS failed");
        }
    }
    let wire, err = http_build_request(request);
    if (err) {
        net_conn_close(upstream);
        return proxy_error(method, "request rebuild failed");
    }
    let _, err = net_conn_write(upstream, wire);
    if (err) {
        net_conn_close(upstream);
        return proxy_error(method, "upstream write failed");
    }
    let resp, err = http_conn_read_response(upstream, 15000, method);
    net_conn_close(upstream);
    if (err) {
        return proxy_error(method, "upstream read failed");
    }
    return resp;
};

let respond = fn(client, resp, method) {
    let wire, err = http_build_response(resp, method);
    if (err) {
        putln("  [!] response rebuild failed: ", err);
        wire = BAD_GATEWAY;
    }
    net_conn_write(client, wire);
    net_conn_close(client);
};

let handle_connect = fn(client, ca, host_port) {
    let host = split_authority(host_port)["host"];
    net_conn_write(client, "HTTP/1.1 200 Connection Established\r\n\r\n");

    let leaf, err = tls_sign_cert(ca["cert_pem"], ca["key_pem"], {"common_name": host, "dns_names": [host]});
    if (err) {
        putln("  [!] leaf issuance failed: ", err);
        net_conn_close(client);
        return;
    }
    let _, err = net_tls_upgrade_server(client, leaf["cert_pem"], leaf["key_pem"]);
    if (err) {
        putln("  [!] client TLS handshake failed: ", err);
        net_conn_close(client);
        return;
    }
    let request, err = http_conn_read_request(client, 15000);
    if (err) {
        net_conn_close(client);
        return;
    }
    putln("  [intercept] ", request["method"], " https://", host, request["path"]);

    let resp = relay(host_port, host, request);
    putln("  [response ] ", resp["status"], " (", len(resp["body"]), " bytes)");
    respond(client, resp, request["method"]);
};

let handle_client = fn(client, ca) {
    let request, err = http_conn_read_request(client, 15000);
    if (err) {
        net_conn_close(client);
        return;
    }
    if (request["method"] == "CONNECT") {
        handle_connect(client, ca, request["host"]);
        return;
    }

    let addr = request["host"];
    if (split_authority(addr)["port"] == "") {
        addr = addr + ":80";
    }
    putln("  [plain    ] ", request["method"], " ", request["url"]);

    let resp = relay(addr, "", request);
    putln("  [response ] ", resp["status"]);
    respond(client, resp, request["method"]);
};

let run_proxy = fn(bind_addr) {
    let ca, err = tls_generate_ca({"common_name": "Mutant Intercept CA", "organization": "Mutant"});
    if (err) {
        putln("CA generation failed: ", err);
        return false;
    }
    putln("=== Mutant intercepting proxy ===");
    putln("Trust this CA certificate in your client to intercept HTTPS:");
    putln(ca["cert_pem"]);

    let ln, err = net_listen(bind_addr);
    if (err) {
        putln("listen failed: ", err);
        return false;
    }
    putln("proxy listening on ", bind_addr, " (set as your HTTP+HTTPS proxy)");

    // spawn passes one argument, so each task gets the CA as a captured copy.
    let serve_one = fn(client) {
        handle_client(client, ca);
    };
    while (true) {
        let acc, _ = net_accept(ln, 0);
        if (!acc["ok"]) {
            continue;
        }
        let _, err = spawn(serve_one, acc["handle"]);
        if (err) {
            putln("  [!] at capacity, dropping a connection: ", err);
            net_conn_close(acc["handle"]);
        }
    }
    return true;
};

run_proxy("127.0.0.1:8080");
