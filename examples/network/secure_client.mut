// Opens a verified TLS connection and speaks HTTP over it.
// mutant:sweep needs-input -- opens a TLS connection to example.com:443 over the internet

let fetch_secure = fn(host, addr) {
    putln("=== Secure client: connecting to ", addr, " ===");
    let conn, err = net_connect(addr, 5000);
    if (err) {
        putln("connect failed: ", err);
        return false;
    }

    let info, err = net_tls_upgrade_client(conn, {"server_name": host, "min_version": "1.2"});
    if (err) {
        putln("TLS handshake failed: ", err);
        net_conn_close(conn);
        return false;
    }
    putln("negotiated ", info["tls_version"], " / ", info["cipher"]);

    let headers = {"Connection": "close", "User-Agent": "mutant-secure-client"};
    let raw, err = http_build_request({"method": "GET", "path": "/", "host": host, "headers": headers});
    if (err) {
        putln("request build failed: ", err);
        net_conn_close(conn);
        return false;
    }
    let _, err = net_conn_write(conn, raw);
    if (err) {
        putln("write failed: ", err);
        net_conn_close(conn);
        return false;
    }

    let resp, err = http_conn_read_response(conn, 5000);
    if (err) {
        putln("read failed: ", err);
    } else {
        putln("HTTP status: ", resp["status"]);
        putln("body bytes:  ", len(resp["body"]));
    }

    net_conn_close(conn);
    putln("=== done ===");
    return true;
};

fetch_secure("example.com", "example.com:443");
