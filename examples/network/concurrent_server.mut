// A concurrent HTTP server: net_serve runs concurrent_server_handler.mut for each connection on its own VM.
// mutant:sweep server -- binds 127.0.0.1:8130 and serves until interrupted

let bind = "127.0.0.1:8130";

let ln, err = net_listen(bind);
if (err) {
    putln("listen failed: ", err);
} else {
    putln("concurrent server listening on ", bind);
    putln("each request sleeps 1s; fire several at once to see them overlap.");
    let _, err = net_serve(ln, "examples/network/concurrent_server_handler.mut", "demo-context");
    putln("serve ended: ", err);
}
