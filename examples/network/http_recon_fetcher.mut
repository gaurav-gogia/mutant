// Fetches /, /robots.txt and /sitemap.xml for each domain and records the answers in a graph and a JSON report.
// mutant:sweep needs-input -- fetches example.com and httpbin.org over the internet

let warn = fn(op, err) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

let add_node = fn(db, kind, props) {
    let node, err = db_add_node(db, kind);
    warn("db_add_node", err);
    for (key, value in props) {
        let _, err = db_index_prop(db, node, key, value);
        warn("db_index_prop", err);
    }
    return node;
};

putln("=== http_recon_fetcher ===");
putln("Safe use: this tool targets public test domains only by default.");

let out_dir = "example_output/http_recon_fetcher";
let input_path = out_dir + "/domains.json";
let graph_path = out_dir + "/recon_graph";
let report_path = out_dir + "/report.json";

let _, err = fs_mkdir(out_dir);
if (err) {
    putln("failed to create output directory: ", err);
}

let exists, err = fs_exists(input_path);
warn("fs_exists", err);
if (!exists) {
    let seed_json, err = json_stringify({"domains": ["https://example.com", "https://httpbin.org"]});
    warn("json_stringify", err);
    let _, err = fs_write(input_path, seed_json);
    if (err) {
        putln("failed to seed dataset: ", err);
    } else {
        putln("seeded test dataset: ", input_path);
    }
}

let input_json, err = fs_read(input_path);
warn("fs_read", err);
let config, err = json_parse(input_json);
warn("json_parse", err);
let domains = config["domains"];

let NODE_DOMAIN = 1;
let NODE_ENDPOINT = 2;
let EDGE_HAS_ENDPOINT = 1;

let db, err = db_open_disk(graph_path);
warn("db_open_disk", err);

let findings = [];
for (domain in domains) {
    putln("scanning: ", domain);
    let domain_node = add_node(db, NODE_DOMAIN, {"url": domain});

    let answers = {};
    for (path in ["/", "/robots.txt", "/sitemap.xml"]) {
        let resp, err = http_get(domain + path);
        warn("http_get", err);
        answers[path] = resp;

        let node = add_node(db, NODE_ENDPOINT, {"path": path, "status": to_string(resp["status"])});
        let _, err = db_add_edge(db, domain_node, node, EDGE_HAS_ENDPOINT);
        warn("db_add_edge", err);
    }

    let root = answers["/"];
    let robots = answers["/robots.txt"];
    let sitemap = answers["/sitemap.xml"];
    findings = push(findings, {"domain": domain, "root_status": root["status"], "redirect_location": root["headers"]["Location"], "robots_status": robots["status"], "sitemap_status": sitemap["status"], "errors": {"root": root["error"], "robots": robots["error"], "sitemap": sitemap["error"]}});
}

let stats, err = db_stats(db);
warn("db_stats", err);
let _, err = db_close(db);
warn("db_close", err);

let report = {"profile": "http_recon_fetcher", "input_file": input_path, "domains_processed": len(domains), "graph_path": graph_path, "graph_stats": stats, "findings": findings};
let report_json, err = json_stringify(report);
warn("json_stringify", err);
let _, err = fs_write(report_path, report_json);
if (err) {
    putln("failed to write report: ", err);
} else {
    putln("wrote report: ", report_path);
}
