// Takes one status snapshot of each endpoint and records it in a graph and a JSON report.
// mutant:sweep needs-input -- polls example.com and httpbin.org over the internet

let warn = fn(op, err) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

let add_node = fn(db, kind, props) {
    let node, err = db_add_node(db, kind);
    warn("db_add_node", err);
    for (key, value in props) {
        let _, err = db_index_prop(db, node, key, value);
        warn("db_index_prop", err);
    }
    return node;
};

putln("=== http_status_monitor ===");
putln("Mode: single-shot snapshot. Schedule periodic runs externally (Task Scheduler/cron).");

let out_dir = "example_output/http_status_monitor";
let input_path = out_dir + "/endpoints.json";
let graph_path = out_dir + "/status_graph";
let report_path = out_dir + "/report.json";

let _, err = fs_mkdir(out_dir);
if (err) {
    putln("failed to create output directory: ", err);
}

let exists, err = fs_exists(input_path);
warn("fs_exists", err);
if (!exists) {
    let seed = {"endpoints": ["https://example.com", "https://httpbin.org/status/200", "https://httpbin.org/status/503"]};
    let seed_json, err = json_stringify(seed);
    warn("json_stringify", err);
    let _, err = fs_write(input_path, seed_json);
    if (err) {
        putln("failed to seed dataset: ", err);
    } else {
        putln("seeded test dataset: ", input_path);
    }
}

let input_json, err = fs_read(input_path);
warn("fs_read", err);
let config, err = json_parse(input_json);
warn("json_parse", err);

let NODE_ENDPOINT = 1;
let NODE_CHECK = 2;
let EDGE_HAS_CHECK = 1;

let db, err = db_open_disk(graph_path);
warn("db_open_disk", err);

let checks = [];
let up_count = 0;
let down_count = 0;
for (endpoint in config["endpoints"]) {
    let resp, err = http_get(endpoint);
    warn("http_get", err);
    let status = resp["status"];

    let status_class = "network_error";
    if (status > 199) {
        status_class = "2xx";
    }
    if (status > 299) {
        status_class = "3xx";
    }
    if (status > 399) {
        status_class = "4xx";
    }
    if (status > 499) {
        status_class = "5xx";
    }

    let is_up = status > 199 && status < 400;
    if (is_up) {
        up_count++;
    } else {
        down_count++;
    }

    let endpoint_node = add_node(db, NODE_ENDPOINT, {"url": endpoint});
    let check_node = add_node(db, NODE_CHECK, {"status": to_string(status), "class": status_class, "is_up": to_string(is_up)});
    let _, err = db_add_edge(db, endpoint_node, check_node, EDGE_HAS_CHECK);
    warn("db_add_edge", err);

    checks = push(checks, {"endpoint": endpoint, "status": status, "class": status_class, "is_up": is_up, "error": resp["error"]});
}

let stats, err = db_stats(db);
warn("db_stats", err);
let _, err = db_close(db);
warn("db_close", err);

let report = {"profile": "http_status_monitor", "mode": "single_shot", "input_file": input_path, "checks_total": len(checks), "up_count": up_count, "down_count": down_count, "graph_path": graph_path, "graph_stats": stats, "checks": checks};
let report_json, err = json_stringify(report);
warn("json_stringify", err);
let _, err = fs_write(report_path, report_json);
if (err) {
    putln("failed to write report: ", err);
} else {
    putln("wrote report: ", report_path);
}
