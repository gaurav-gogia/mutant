// Per-connection handler for concurrent_server.mut: serve_conn() is the connection, serve_arg() the shared context.
// mutant:sweep serve-handler -- net_serve dispatches this; standalone it has no connection to read

let conn, _ = serve_conn();
let ctx, _ = serve_arg();

let path = "/";
let req, err = http_conn_read_request(conn, 8000);
if (!err) {
    path = req["path"];
}

sleep_ms(1000);

let resp = {"status": 200, "status_text": "OK", "body": "served " + path + " (ctx=" + ctx + ")", "headers": {}};
let wire, _ = http_build_response(resp);
net_conn_write(conn, wire);
net_conn_close(conn);
