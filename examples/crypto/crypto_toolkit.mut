// Hashing, HMAC, AES-GCM, certificate parsing and JWT decoding, with no external input.
let run = fn() {
    putln("=== crypto_toolkit ===");

    let msg = "the quick brown fox";
    putln("sha256:", hash_sha256(msg));
    putln("hmac  :", hmac("secret-key", msg, "sha256"));

    let key = "0123456789abcdef0123456789abcdef";
    let ct, err = aes_encrypt(key, "top secret payload");
    if (err) {
        putln("[error] aes_encrypt:", err);
        return false;
    }
    let pt, err = aes_decrypt(key, ct);
    if (err) {
        putln("[error] aes_decrypt:", err);
        return false;
    }
    putln("aes round-trip ok:", pt == "top secret payload");

    let _, bad_key_err = aes_decrypt("ffffffffffffffffffffffffffffffff", ct);
    putln("wrong key rejected:", bad_key_err != false);

    let ca, err = tls_generate_ca();
    if (err) {
        putln("[error] tls_generate_ca:", err);
        return false;
    }
    let cert, err = x509_parse(ca["cert_pem"]);
    if (err) {
        putln("[error] x509_parse:", err);
    } else {
        putln("CA subject:", cert["subject"]);
        putln("CA is_ca  :", cert["is_ca"]);
        putln("sha256 fp :", cert["sha256"]);
    }

    let token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjMiLCJuYW1lIjoiYWxpY2UifQ.c2lnbmF0dXJl";
    let jwt, err = jwt_decode(token);
    if (err) {
        putln("[error] jwt_decode:", err);
    } else {
        putln("jwt alg:", jwt["algorithm"]);
        putln("jwt sub:", jwt["claims"]["sub"]);
        putln("jwt verified:", jwt["verified"]);
    }

    putln("uuid :", uuid_v4());
    putln("nonce:", random_hex(16));
    return true;
};

run();
