// Open a case, touch evidence, verify and seal the manifest, and write the handover bundle.

putln("=== chain_of_custody ===");

let check_err = fn(err, op) {
    if (err) {
        putln("[error]", op, ":", err);
        return true;
    }
    return false;
};

let output_directory = "example_output/chain_of_custody";
let manifest_path = output_directory + "/manifest.json";
let image_path = "examples/data/sample_win.exe";
let exhibit_path = "examples/data/phish.eml";

let run = fn() {
    let _, err = fs_mkdir(output_directory);
    if (check_err(err, "fs_mkdir")) {
        return false;
    }

    let opened, err = case_open("IR-2026-0413", "example examiner", {"hash": "sha256"});
    if (check_err(err, "case_open")) {
        return false;
    }
    putln("case:", opened["id"], " examiner:", opened["examiner"], " hash policy:", opened["hash_policy"]);

    let _, err = case_note("acquired from the evidence locker, seal EV-99812");
    if (check_err(err, "case_note")) {
        return false;
    }

    let image, err = raw_open(image_path);
    if (check_err(err, "raw_open")) {
        return false;
    }
    let handle = image["handle"];

    let header, err = raw_read_at(handle, 0, 2);
    if (check_err(err, "raw_read_at header")) {
        return false;
    }
    putln("first two bytes of the image:", header);

    let meta, err = raw_metadata(handle);
    if (check_err(err, "raw_metadata")) {
        return false;
    }
    putln("image size:", meta["file_size"], "bytes");

    let _, err = raw_close(handle);
    if (check_err(err, "raw_close")) {
        return false;
    }

    let exhibit, err = case_evidence(exhibit_path);
    if (check_err(err, "case_evidence")) {
        return false;
    }
    putln("registered exhibit:", exhibit["path"], " sha256:", exhibit["hash"]);

    let drift, err = case_verify();
    if (check_err(err, "case_verify")) {
        return false;
    }
    putln("verify:", drift["checked"], "checked,", drift["unchanged"], "unchanged,", drift["changed"], "changed,", drift["missing"], "missing");

    let written, err = case_write(manifest_path);
    if (check_err(err, "case_write")) {
        return false;
    }
    putln("manifest:", written["path"], " ", written["bytes"], "bytes  signed:", written["signed"]);
    putln("manifest hash:", written["manifest_hash"]);

    let check, err = case_manifest_verify(manifest_path);
    if (check_err(err, "case_manifest_verify")) {
        return false;
    }
    putln("hash matches:", check["hash_matches"], " signature valid:", check["signature_valid"]);
    putln("  ", check["signature_detail"]);

    let bundle, err = case_bundle(output_directory + "/handover");
    if (check_err(err, "case_bundle")) {
        return false;
    }
    putln("bundle:", bundle["dir"], " signed:", bundle["signed"]);
    for (entry in bundle["files"]) {
        putln("  ", entry["name"], " ", entry["bytes"], "bytes ", entry["sha256"]);
    }

    let manifest, err = case_close();
    if (check_err(err, "case_close")) {
        return false;
    }

    let integrity = manifest["integrity"];
    putln("--- manifest ---");
    putln("sources:", integrity["sources_total"], " hashed:", integrity["sources_hashed"], " evidence read-only:", integrity["evidence_read_only"]);
    for (source in manifest["evidence"]) {
        putln("evidence:", source["path"]);
        putln("  size:", source["size"], " hashed:", source["hashed"]);
        for (touch in source["touches"]) {
            putln("  touched by", touch["builtin"], "x" + to_string(touch["count"]));
        }
    }

    let program = manifest["program"];
    if (program["recorded"]) {
        putln("produced by:", program["path"], " sha256:", program["hash"]);
    } else {
        putln("produced by: not recorded --", program["detail"]);
    }
    return true;
};

run();
