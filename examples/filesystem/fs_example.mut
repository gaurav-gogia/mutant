let path = "example_output.txt";

let wrote, _ = fs_write(path, "hello from mutant\n");
if (wrote) {
    putln("wrote file");
} else {
    putln("write failed");
}

let appended, _ = fs_append(path, "second line\n");
if (appended) {
    putln("appended to file");
}

let contents, _ = fs_read(path);
putln("file contents:");
putln(contents);

let info, _ = fs_stat(path);
putln("file name:     ", info["name"]);
putln("file size:     ", info["size"]);
putln("is directory:  ", info["is_dir"]);
putln("modified:      ", info["mod_time"]);

let exists, _ = fs_exists(path);
putln("file exists: ", exists);

let made, _ = fs_mkdir("example_dir");
if (made) {
    putln("created directory");
}

let copied, _ = fs_copy(path, "example_dir/copy.txt");
if (copied) {
    putln("copied file");
}

let listing, _ = fs_list("example_dir");
putln("directory listing:");
for (entry in listing) {
    putln("  ", entry["name"], "  size=", entry["size"], "  dir=", entry["is_dir"]);
}

let moved, _ = fs_move("example_dir/copy.txt", "example_dir/moved.txt");
if (moved) {
    putln("moved file");
}

let deleted, _ = fs_delete(path);
if (deleted) {
    putln("deleted original file");
}
