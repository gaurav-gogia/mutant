// mutant:sweep needs-input -- queries api.osv.dev over the internet for each dependency

let check = fn(err, op) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

putln("=== dependency_version_auditor ===");
putln("Safe use: reads local dependency manifests and queries public vulnerability API.");

let output_directory = "example_output/dependency_version_auditor";
let package_path = output_directory + "/package.json";
let gomod_path = output_directory + "/go.mod";
let graph_path = output_directory + "/dep_graph";
let report_path = output_directory + "/report.json";

let made, _ = fs_mkdir(output_directory);
if (!made) {
    putln("failed to create output directory");
}

let package_exists, package_err = fs_exists(package_path);
check(package_err, "fs_exists package");
if (!package_exists) {
    let seed, _ = json_stringify({"name": "demo", "dependencies": {"express": "4.17.1", "lodash": "4.17.20"}});
    let wrote, err = fs_write(package_path, seed);
    check(err, "fs_write package");
    if (wrote) {
        putln("seeded package.json: ", package_path);
    }
}

let gomod_exists, gomod_err = fs_exists(gomod_path);
check(gomod_err, "fs_exists gomod");
if (!gomod_exists) {
    let wrote, err = fs_write(gomod_path, "module demo\n\nrequire github.com/gin-gonic/gin v1.9.1\n");
    check(err, "fs_write gomod");
    if (wrote) {
        putln("seeded go.mod: ", gomod_path);
    }
}

let extract_npm_lua = "local data,err=mutant.read_file('example_output/dependency_version_auditor/package.json'); if not data then return '[]' end; local dq=string.char(34); local out={}; for name,ver in string.gmatch(data, dq..'([%w%-%._]+)'..dq..'%s*:%s*'..dq..'([^'..dq..']+)'..dq) do if name ~= 'name' and name ~= 'dependencies' then local item='{'..dq..'name'..dq..':'..dq..name..dq..','..dq..'version'..dq..':'..dq..ver..dq..','..dq..'ecosystem'..dq..':'..dq..'npm'..dq..'}'; table.insert(out,item); end end; return '['..table.concat(out,',')..']'";
let npm_result, npm_err = lua_run_string(extract_npm_lua);
check(npm_err, "lua_run_string npm");

let extract_go_lua = "local data,err=mutant.read_file('example_output/dependency_version_auditor/go.mod'); if not data then return '[]' end; local dq=string.char(34); local out={}; for line in string.gmatch(data, '[^\\n]+') do local mod,ver=string.match(line,'^%s*require%s+([%w%-%._/]+)%s+v([%w%._%-]+)'); if mod and ver then local item='{'..dq..'name'..dq..':'..dq..mod..dq..','..dq..'version'..dq..':'..dq..ver..dq..','..dq..'ecosystem'..dq..':'..dq..'Go'..dq..'}'; table.insert(out,item); end end; return '['..table.concat(out,',')..']'";
let go_result, go_err = lua_run_string(extract_go_lua);
check(go_err, "lua_run_string go");

// The Lua script's own return value is under "result".
let npm_deps, npm_parse_err = json_parse(npm_result["result"]);
check(npm_parse_err, "json_parse npm_deps");
let go_deps, go_parse_err = json_parse(go_result["result"]);
check(go_parse_err, "json_parse go_deps");

let NODE_DEP = 1;
let NODE_FINDING = 2;
let EDGE_HAS_FINDING = 1;

let db, db_err = db_open_disk(graph_path);
check(db_err, "db_open_disk");

let audit = fn(deps, tag) {
    let found = [];
    for (i, dep in deps) {
        let dep_node, err = db_add_node(db, NODE_DEP);
        check(err, "db_add_node dep " + tag);
        for (key in ["name", "version", "ecosystem"]) {
            let _, prop_err = db_index_prop(db, dep_node, key, dep[key]);
            check(prop_err, "db_index_prop");
        }

        let body = {"package": {"name": dep["name"], "ecosystem": dep["ecosystem"]}, "version": dep["version"]};
        let resp, post_err = http_post("https://api.osv.dev/v1/query", body, "application/json");
        check(post_err, "http_post " + tag);

        let response_path = output_directory + "/osv_" + tag + "_" + to_string(i) + ".json";
        let _, write_err = fs_write(response_path, resp["body"]);
        check(write_err, "fs_write");

        let vuln_signal = text_contains(resp["body"], "vulns");

        let finding_node, finding_err = db_add_node(db, NODE_FINDING);
        check(finding_err, "db_add_node finding " + tag);
        let props = {"source": "osv", "status": to_string(resp["status"]), "vuln_signal": to_string(vuln_signal)};
        for (key, value in props) {
            let _, prop_err = db_index_prop(db, finding_node, key, value);
            check(prop_err, "db_index_prop");
        }
        let _, edge_err = db_add_edge(db, dep_node, finding_node, EDGE_HAS_FINDING);
        check(edge_err, "db_add_edge");

        found = push(found, {"name": dep["name"], "version": dep["version"], "ecosystem": dep["ecosystem"], "status": resp["status"], "vuln_signal": vuln_signal, "error": resp["error"]});
    }
    return found;
};

let findings = concat(audit(npm_deps, "npm"), audit(go_deps, "go"));

let stats, stats_err = db_stats(db);
check(stats_err, "db_stats");
let closed, close_err = db_close(db);
check(close_err, "db_close");
if (!closed) {
    putln("db close error");
}

let report = {"profile": "dependency_version_auditor", "package_file": package_path, "gomod_file": gomod_path, "dependencies_checked": len(findings), "graph_path": graph_path, "graph_stats": stats, "findings": findings};

let report_json, json_err = json_stringify(report);
check(json_err, "json_stringify report");
let wrote_report, write_err = fs_write(report_path, report_json);
check(write_err, "fs_write report");
if (wrote_report) {
    putln("wrote report: ", report_path);
} else {
    putln("failed to write report");
}
