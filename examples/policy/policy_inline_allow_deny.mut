putln("=== Inline Policy Example ===");

let module = """
    package triage

    default allow = false

    allow {
      input.severity == "low"
      input.source != "guest"
    }

    decision = {
      "allow": allow,
      "severity": input.severity,
      "source": input.source,
    }

    rules = [
      {"id": "low_only"},
      {"id": "deny_guest"},
    ]
    """;

let policy = {"module": module, "eval_query": "data.triage.decision", "allow_query": "data.triage.allow", "rules_query": "data.triage.rules"};

let loaded, err = policy_load("triage_policy", policy);
putln("policy_load:", loaded, "err:", err);

let facts = {"severity": "low", "source": "sensor-a"};
let decision, err = policy_eval("triage_policy", facts);
putln("policy_eval:", decision, "err:", err);

let allowed, err = policy_allow("triage_policy", facts);
putln("policy_allow:", allowed, "err:", err);
