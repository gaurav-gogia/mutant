putln("=== Policy Engine Builtins ===");

let module = """
    package access

    default allow = false

    allow {
      startswith(input.path, "/safe")
      input.user != "guest"
    }

    decision = {"path": input.path, "user": input.user, "allow": allow}

    rules = [
      {"id": "allow_safe_path", "description": "path must start with /safe"},
      {"id": "deny_guest_user", "description": "guest user denied"}
    ]
    """;

let policy = {"module": module, "eval_query": "data.access.decision", "allow_query": "data.access.allow", "rules_query": "data.access.rules"};

let loaded, err = policy_load("access_policy", policy);
putln("policy_load:", loaded, "err:", err);

let facts = {"path": "/safe/bin", "user": "analyst"};

let decision, err = policy_eval("access_policy", facts);
putln("policy_eval:", decision, "err:", err);

let allowed, err = policy_allow("access_policy", facts);
putln("policy_allow:", allowed, "err:", err);

let rules, err = policy_rules("access_policy");
putln("policy_rules:", rules, "err:", err);

let trace, err = policy_trace("access_policy", facts);
putln("policy_trace:", trace, "err:", err);
