// A module: every top-level name is exported except those starting with _.

let _total = fn(values) {
    let sum = 0;
    for (let i = 0; i < len(values); i = i + 1) {
        sum = sum + values[i];
    }
    return sum;
};

let sum = fn(values) {
    return _total(values);
};

let mean = fn(values) {
    if (len(values) == 0) {
        return 0;
    }
    return _total(values) / len(values);
};

let largest = fn(values) {
    let best = values[0];
    for (let i = 1; i < len(values); i = i + 1) {
        if (values[i] > best) {
            best = values[i];
        }
    }
    return best;
};

// Struct, enum and macro names are program-global: importers write them bare.
struct Sample { name; values; }

enum Grade { Fast, Slow }

let doubled = macro(value) {
    quote(unquote(value) + unquote(value));
};
