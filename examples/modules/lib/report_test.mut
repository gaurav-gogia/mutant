// Tests for report.mut, which brings stats.mut in with it.

import "report.mut";

let latencies = [12, 47, 31, 8, 92];

before_each(fn() {
    latencies = [12, 47, 31, 8, 92];
});

test("line reports every statistic it promises", fn() {
    let rendered = report.line("latencies", latencies);
    assert_contains(rendered, "sum=190");
    assert_contains(rendered, "mean=38");
    assert_contains(rendered, "max=92");
});

test("line upper-cases the name it was given", fn() {
    assert_contains(report.line("latencies", latencies), "LATENCIES");
});

test("a module's top-level name is its own", fn() {
    assert_eq(report.label, "report.mut");
});
