let check = fn(err, op) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

putln("=== mini_timeline_builder ===");
putln("Builds a simple file metadata timeline using fs_stat and graph DB.");

let output_directory = "example_output/mini_timeline_builder";
let input_file_path = output_directory + "/files.json";
let graph_path = output_directory + "/timeline_graph";
let report_path = output_directory + "/report.json";

let made, _ = fs_mkdir(output_directory);
if (made == false) {
    putln("failed to create output directory");
}

let exists, err = fs_exists(input_file_path);
check(err, "fs_exists");
if (exists == false) {
    let seed = {"files": [output_directory + "/file1.txt", output_directory + "/file2.log", output_directory + "/archive.zip"]};
    let seed_json, err = json_stringify(seed);
    check(err, "json_stringify seed");
    let seeded, err = fs_write(input_file_path, seed_json);
    check(err, "fs_write seed");
    if (seeded) {
        putln("seeded test dataset: ", input_file_path);
    }
}

let source_json, err = fs_read(input_file_path);
check(err, "fs_read input");
let parsed, err = json_parse(source_json);
check(err, "json_parse input");
let files = parsed["files"];

for (let i = 0; i < len(files); i = i + 1) {
    let file_exists, err = fs_exists(files[i]);
    check(err, "fs_exists file");
    if (file_exists == false) {
        let index_text, err = json_stringify(i);
        check(err, "json_stringify file index");
        let _, err = fs_write(files[i], "seed-content-" + index_text);
        check(err, "fs_write");
    }
}

let NODE_FILE = 1;
let NODE_EVENT = 2;
let EDGE_HAS_EVENT = 1;
let EDGE_NEXT_EVENT = 2;

let db, err = db_open_disk(graph_path);
check(err, "db_open_disk");
let timeline = [];
let event_nodes = [];

for (path in files) {
    let st, err = fs_stat(path);
    check(err, "fs_stat");

    let file_node, err = db_add_node(db, NODE_FILE);
    check(err, "db_add_node file");
    let _, err = db_index_prop(db, file_node, "path", path);
    check(err, "db_index_prop");

    let event_node, err = db_add_node(db, NODE_EVENT);
    check(err, "db_add_node event");
    let _, err = db_index_prop(db, event_node, "mod_time", st["mod_time"]);
    check(err, "db_index_prop");
    let size_text, err = json_stringify(st["size"]);
    check(err, "json_stringify size");
    let _, err = db_index_prop(db, event_node, "size", size_text);
    check(err, "db_index_prop");
    if (type_of(st["error"]) == "STRING") {
        let _, err = db_index_prop(db, event_node, "error", st["error"]);
        check(err, "db_index_prop");
    }

    let _, err = db_add_edge(db, file_node, event_node, EDGE_HAS_EVENT);
    check(err, "db_add_edge");

    event_nodes = push(event_nodes, event_node);
    timeline = push(timeline, {"path": path, "size": st["size"], "mod_time": st["mod_time"], "error": st["error"]});
}

for (let i = 1; i < len(event_nodes); i = i + 1) {
    let _, err = db_add_edge(db, event_nodes[i - 1], event_nodes[i], EDGE_NEXT_EVENT);
    check(err, "db_add_edge");
}

let stats, err = db_stats(db);
check(err, "db_stats");
let closed, err = db_close(db);
check(err, "db_close");
if (closed == false) {
    putln("db close error");
}

let report = {"profile": "mini_timeline_builder", "input_file": input_file_path, "files_processed": len(files), "graph_path": graph_path, "graph_stats": stats, "timeline": timeline};

let report_json, err = json_stringify(report);
check(err, "json_stringify report");
let written, err = fs_write(report_path, report_json);
check(err, "fs_write report");
if (written) {
    putln("wrote report: ", report_path);
} else {
    putln("failed to write report");
}
