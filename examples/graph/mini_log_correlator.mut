// Correlates repeated failed logins into a disk graph and a JSON report.
let check = fn(err, op) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

putln("=== mini_log_correlator ===");
putln("Safe use: local defensive log analytics only.");

let output_directory = "example_output/mini_log_correlator";
let input_file_path = output_directory + "/test_logs.json";
let graph_path = output_directory + "/correlation_graph";
let report_path = output_directory + "/report.json";

let made, _ = fs_mkdir(output_directory);
if (made == false) {
    putln("failed to create output directory");
}

let exists, err = fs_exists(input_file_path);
check(err, "fs_exists");
if (exists == false) {
    let seed = {"logs": [{"ts": 1, "ip": "10.0.0.1", "event": "login_failed"}, {"ts": 2, "ip": "10.0.0.1", "event": "login_failed"}, {"ts": 3, "ip": "10.0.0.2", "event": "login_success"}]};
    let seed_json, err = json_stringify(seed);
    check(err, "json_stringify seed");
    let seeded, err = fs_write(input_file_path, seed_json);
    check(err, "fs_write seed");
    if (seeded) {
        putln("seeded test dataset: ", input_file_path);
    } else {
        putln("failed to seed dataset");
    }
}

let source_json, err = fs_read(input_file_path);
check(err, "fs_read input");
let parsed, err = json_parse(source_json);
check(err, "json_parse input");
let logs = parsed["logs"];

let NODE_IP = 1;
let NODE_PATTERN = 2;
let EDGE_HAS_PATTERN = 1;

let db, err = db_open_disk(graph_path);
check(err, "db_open_disk");
let suspicious = [];

for (current in logs) {
    if (current["event"] != "login_failed") {
        continue;
    }

    let failed_count = 0;
    for (other in logs) {
        if (other["ip"] == current["ip"] && other["event"] == "login_failed") {
            failed_count = failed_count + 1;
        }
    }
    if (failed_count < 2) {
        continue;
    }

    let known = false;
    for (seen in suspicious) {
        if (seen["ip"] == current["ip"]) {
            known = true;
        }
    }
    if (known) {
        continue;
    }

    let ip_node, err = db_add_node(db, NODE_IP);
    check(err, "db_add_node ip");
    let _, err = db_index_prop(db, ip_node, "ip", current["ip"]);
    check(err, "db_index_prop");

    let pattern_node, err = db_add_node(db, NODE_PATTERN);
    check(err, "db_add_node pattern");
    let _, err = db_index_prop(db, pattern_node, "pattern", "repeated_login_failed");
    check(err, "db_index_prop");
    let count_json, err = json_stringify(failed_count);
    check(err, "json_stringify failed_count");
    let _, err = db_index_prop(db, pattern_node, "count", count_json);
    check(err, "db_index_prop");

    let _, err = db_add_edge(db, ip_node, pattern_node, EDGE_HAS_PATTERN);
    check(err, "db_add_edge");

    suspicious = push(suspicious, {"ip": current["ip"], "pattern": "repeated_login_failed", "failed_count": failed_count});
}

let stats, err = db_stats(db);
check(err, "db_stats");
let closed, err = db_close(db);
check(err, "db_close");
if (closed == false) {
    putln("db close error");
}

let report = {"profile": "mini_log_correlator", "input_file": input_file_path, "events_processed": len(logs), "suspicious_patterns": len(suspicious), "graph_path": graph_path, "graph_stats": stats, "findings": suspicious};

let report_json, err = json_stringify(report);
check(err, "json_stringify report");
let written, err = fs_write(report_path, report_json);
check(err, "fs_write report");
if (written) {
    putln("wrote report: ", report_path);
} else {
    putln("failed to write report");
}
