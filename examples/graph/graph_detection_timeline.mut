putln("=== Graph + Detection Timeline ===");

let db, err = db_open();
if (err) {
    putln("db_open error:", err);
    return;
}

let proc, _ = db_add_artifact(db, "process", {"pid": 4021, "name": "powershell.exe"});
let file, _ = db_add_artifact(db, "file", {"path": "C:/Users/Public/updater.ps1"});
let net, _ = db_add_artifact(db, "network", {"dst": "198.51.100.25", "port": 443});

db_add_relation(db, proc["node_id"], file["node_id"], "writes");
db_add_relation(db, proc["node_id"], net["node_id"], "connects_to");

let timeline, err = db_timeline(db);
putln("timeline events:", len(timeline), "err:", err);

let flows = [{"dst": "198.51.100.25"}, {"dst": "198.51.100.25"}, {"dst": "198.51.100.25"}];
let beacon, err = detect_network_beacon(flows);
putln("detect_network_beacon:", beacon, "err:", err);

let _, err = db_close(db);
putln("db_close err:", err);
