// Uses enums as graph node and edge types.
let check = fn(err, op) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

enum NodeType { DATA, PERSON, DOCUMENT, HOST }
enum EdgeType { DATA, KNOWS, AUTHORED, CONNECTS_TO }

putln("=== GrapheneDB Example With Enums ===");

let db, err = db_open();
check(err, "db_open");
putf("opened graph db, handle: %v\n", db);

let person_a, _ = db_add_node(db, NodeType.PERSON);
let person_b, _ = db_add_node(db, NodeType.PERSON);
let person_c, _ = db_add_node(db, NodeType.PERSON);
let doc, err = db_add_node(db, NodeType.DOCUMENT);
check(err, "db_add_node DOCUMENT");
putf("added nodes: person_a=%v person_b=%v person_c=%v doc=%v\n", person_a, person_b, person_c, doc);

let e1, _ = db_add_edge(db, person_a, person_b, EdgeType.KNOWS);
let e2, _ = db_add_edge(db, person_b, person_c, EdgeType.KNOWS);
let e3, err = db_add_edge(db, person_a, doc, EdgeType.AUTHORED);
check(err, "db_add_edge AUTHORED");
putf("added edges: %v %v %v\n", e1, e2, e3);

let _, err = db_index_prop(db, person_a, "name", "Person A");
check(err, "db_index_prop");
let _, err = db_index_prop(db, person_b, "name", "Person B");
check(err, "db_index_prop");
let _, err = db_index_prop(db, person_c, "name", "Person C");
check(err, "db_index_prop");

let people, _ = db_query_nodes(db, NodeType.PERSON);
let docs, err = db_query_nodes(db, NodeType.DOCUMENT);
check(err, "db_query_nodes DOCUMENT");
putf("person nodes: %d document nodes: %d\n", len(people), len(docs));

let stats, err = db_stats(db);
check(err, "db_stats");
putf("graph stats — nodes: %v edges: %v\n", stats["nodes"], stats["edges"]);

let closed, err = db_close(db);
check(err, "db_close");
if (closed) {
    putln("graph closed cleanly");
}

putln("");
putln("=== Default DATA Type Demo ===");

let disk_db, err = db_open_disk("./example_graph_data_enums");
check(err, "db_open_disk");
let h1, _ = db_add_node(disk_db);
let h2, err = db_add_node(disk_db);
check(err, "db_add_node default");
let _, err = db_add_edge(disk_db, h1, h2);
check(err, "db_add_edge");

let default_nodes, err = db_query_nodes(disk_db);
check(err, "db_query_nodes default");
putf("default DATA nodes: %d\n", len(default_nodes));

let disk_closed, err = db_close(disk_db);
check(err, "db_close disk");
if (disk_closed) {
    putln("disk graph closed cleanly");
}
