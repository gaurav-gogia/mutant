// Builds a small in-memory graph, traverses it, then writes one to disk.
let check = fn(err, op) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

putln("=== GrapheneDB In-Memory Graph ===");

let db, err = db_open();
check(err, "db_open");
putf("opened graph db, handle: %v\n", db);

let NODE_PERSON = 1;
let NODE_DOCUMENT = 2;
let EDGE_KNOWS = 1;
let EDGE_AUTHORED = 2;

let alice, _ = db_add_node(db, NODE_PERSON);
let bob, _ = db_add_node(db, NODE_PERSON);
let carol, _ = db_add_node(db, NODE_PERSON);
let doc, err = db_add_node(db, NODE_DOCUMENT);
check(err, "db_add_node document");
putf("added nodes: alice=%v bob=%v carol=%v doc=%v\n", alice, bob, carol, doc);

let e1, _ = db_add_edge(db, alice, bob, EDGE_KNOWS);
let e2, _ = db_add_edge(db, bob, carol, EDGE_KNOWS);
let e3, err = db_add_edge(db, alice, doc, EDGE_AUTHORED);
check(err, "db_add_edge authored");
putf("added edges: %v %v %v\n", e1, e2, e3);

db_index_prop(db, alice, "name", "Alice");
db_index_prop(db, bob, "name", "Bob");
let _, err = db_index_prop(db, carol, "name", "Carol");
check(err, "db_index_prop Carol");
putln("indexed properties");

let stats, err = db_stats(db);
check(err, "db_stats");
putf("graph stats — nodes: %v  edges: %v\n", stats["nodes"], stats["edges"]);

putln("");
putln("=== BFS from Alice (depth 2, outbound) ===");
let bfs, err = db_bfs(db, alice, 2, "out");
check(err, "db_bfs");
putf("nodes reachable: %d\n", len(bfs["nodes"]));
putf("edges traversed: %d\n", len(bfs["edges"]));

putln("");
putln("=== Shortest Path: Alice -> Carol ===");
let path, err = db_shortest_path(db, alice, carol);
check(err, "db_shortest_path");
putf("path node count: %d\n", len(path));
for (id in path) {
    putf("  node id: %v\n", id);
}

putln("");
putln("=== Query nodes by type ===");
let people, err = db_query_nodes(db, NODE_PERSON);
check(err, "db_query_nodes person");
putf("person nodes: %d\n", len(people));
let docs, err = db_query_nodes(db, NODE_DOCUMENT);
check(err, "db_query_nodes document");
putf("document nodes: %d\n", len(docs));

let closed, err = db_close(db);
check(err, "db_close");
if (closed) {
    putln("graph closed cleanly");
}

putln("");
putln("=== Disk-backed Graph ===");
let disk_db, err = db_open_disk("./example_graph_data");
check(err, "db_open_disk");
putf("opened disk graph, handle: %v\n", disk_db);

let n1, _ = db_add_node(disk_db);
let n2, err = db_add_node(disk_db);
check(err, "db_add_node disk");
let _, err = db_add_edge(disk_db, n1, n2);
check(err, "db_add_edge");
let _, err = db_index_prop(disk_db, n1, "ip", "192.168.1.1");
check(err, "db_index_prop");
let _, err = db_index_prop(disk_db, n2, "ip", "192.168.1.2");
check(err, "db_index_prop");

let disk_stats, err = db_stats(disk_db);
check(err, "db_stats disk");
putf("disk graph — nodes: %v  edges: %v\n", disk_stats["nodes"], disk_stats["edges"]);

let disk_closed, err = db_close(disk_db);
check(err, "db_close disk");
if (disk_closed) {
    putln("disk graph closed cleanly");
}
