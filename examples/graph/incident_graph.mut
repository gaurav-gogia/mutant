// Models an intrusion as a graph (process to file, process to network), then traverses it.
putln("=== incident_graph ===");

let db, err = db_open();
if (err) {
    putln("[error] db_open:", err);
    return;
}

let proc, _ = db_add_artifact(db, "process", {"name": "powershell.exe", "pid": 4021});
let file, _ = db_add_artifact(db, "file", {"path": "C:/Users/Public/x.ps1"});
let net, _ = db_add_artifact(db, "network", {"dst": "185.12.0.9", "port": 443});
let proc_id = proc["node_id"];

db_add_relation(db, proc_id, file["node_id"], "wrote");
db_add_relation(db, proc_id, net["node_id"], "connected_to");

db_index_prop(db, proc_id, "name", "powershell.exe");
let found, err = db_find(db, "name", "powershell.exe");
if (err) {
    putln("[error] db_find:", err);
} else {
    putln("nodes named powershell.exe:", found["count"]);
}

let reached, err = db_bfs(db, proc_id, 3, "out");
if (err) {
    putln("[error] db_bfs:", err);
} else {
    putln("nodes reachable from the process:", len(reached["nodes"]));
}

let path, err = db_shortest_path(db, proc_id, net["node_id"]);
if (err) {
    putln("[error] db_shortest_path:", err);
} else {
    if (len(path) == 0) {
        putln("no path to network node");
    } else {
        putln("process -> network path length:", len(path));
    }
}

let touched, err = db_relations(db, proc_id, "out");
if (err) {
    putln("[error] db_relations:", err);
} else {
    for (rel in touched["relations"]) {
        putln("process", rel["relation"], "node", rel["dst"]);
    }
}

let stats, err = db_stats(db);
if (err) {
    putln("[error] db_stats:", err);
} else {
    putln("graph nodes:", stats["nodes"], " edges:", stats["edges"]);
}

db_close(db);
