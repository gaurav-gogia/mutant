// Higher-order collection builtins over a small event dataset.

let run = fn() {
    putln("=== data_pipeline ===");

    let events = [];
    events = push(events, {"host": "web01", "kind": "login_fail", "score": 3});
    events = push(events, {"host": "web01", "kind": "login_fail", "score": 3});
    events = push(events, {"host": "db01", "kind": "exfil", "score": 9});
    events = push(events, {"host": "web02", "kind": "scan", "score": 5});
    events = push(events, {"host": "db01", "kind": "priv_esc", "score": 8});

    let scores = map(events, fn(e) {
        return e["score"];
    });
    putln("scores:", scores);

    let threshold = 8;
    let high = filter(events, fn(e) {
        return e["score"] >= threshold;
    });
    putln("high-severity events:", len(high));

    let total = reduce(scores, fn(acc, s) {
        return acc + s;
    }, 0);
    putln("total risk:", total);
    putln("mean risk:", avg(scores));
    let peak = reduce(scores, fn(acc, s) {
        return max(acc, s);
    }, 0);
    putln("max risk: ", peak);

    let ranked = sort_by(events, fn(e) {
        return -e["score"];
    });
    putln("ranked (highest first):");
    each(ranked, fn(e) {
        putf("  %s  %s  score=%d\n", e["host"], e["kind"], e["score"]);
    });

    let scale = fn(weight) {
        return fn(s) {
            return s * weight;
        };
    };
    putln("weighted (x2):", map(scores, scale(2)));

    let hosts = map(events, fn(e) {
        return e["host"];
    });
    putln("unique hosts:", sort(unique(hosts)));
    return true;
};

run();
