putln("=== Fuzzy Matching Builtins ===");

let dist = text_levenshtein("kitten", "sitting");
putln("text_levenshtein:", dist);

let sim = text_similarity("powershell", "powrshell");
putln("text_similarity:", sim);

let candidates = ["powershell", "rundll32", "cmd", "wmic"];
let found = text_fuzzy_find("powrshell", candidates);
putln("text_fuzzy_find:", found);

let jw = text_jaro_winkler("martha", "marhta");
putln("text_jaro_winkler:", jw);
