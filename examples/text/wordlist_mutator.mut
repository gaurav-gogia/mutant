// Mutates a wordlist with an embedded Lua script.
putln("=== wordlist_mutator ===");
putln("Safe use: for defensive password-strength research only.");

let output_directory = "example_output/wordlist_mutator";
let input_file_path = output_directory + "/test_wordlist.txt";
let mutated_file_path = output_directory + "/mutated_wordlist.txt";
let report_file_path = output_directory + "/report.json";

let made, _ = fs_mkdir(output_directory);
if (made == false) {
    putln("failed to create output directory");
}

let exists, _ = fs_exists(input_file_path);
if (exists == false) {
    let seeded, _ = fs_write(input_file_path, "admin\npassword\nguest\n");
    if (seeded) {
        putln("seeded test dataset: ", input_file_path);
    } else {
        putln("failed to seed dataset");
    }
}

let script = "local data,err=mutant.read_file('example_output/wordlist_mutator/test_wordlist.txt'); if not data then return '' end; local out={}; local seen={}; for line in string.gmatch(data, '[^\\n]+') do line=string.gsub(line,'\\r',''); if line ~= '' then local v1=line; local v2=line..'123'; local v3=line..'2026'; local v4='!'..line; local v5=line..'!'; local v6=string.gsub(line,'a','4'); local v7=string.gsub(line,'e','3'); local v8=string.gsub(line,'i','1'); local v9=string.gsub(line,'o','0'); local v10=string.gsub(line,'s','5'); local vars={v1,v2,v3,v4,v5,v6,v7,v8,v9,v10}; for _,v in ipairs(vars) do if v ~= '' and not seen[v] then seen[v]=true; table.insert(out,v); end end end end; return table.concat(out,'\\n')";
let mutation, err = lua_run_string(script);
if (err) {
    putln("lua mutation failed: ", err);
}

let written, _ = fs_write(mutated_file_path, mutation["result"]);
if (written) {
    putln("wrote mutated list: ", mutated_file_path);
} else {
    putln("failed to write mutated list");
}

let report = {"profile": "wordlist_mutator", "input_file": input_file_path, "output_file": mutated_file_path, "lua_ok": mutation["ok"], "lua_error": mutation["error"]};

let report_json, _ = json_stringify(report);
let reported, _ = fs_write(report_file_path, report_json);
if (reported) {
    putln("wrote report: ", report_file_path);
} else {
    putln("failed to write report");
}
