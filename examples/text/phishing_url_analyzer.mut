// mutant:sweep needs-input -- downloads a phishing feed from raw.githubusercontent.com and fetches each URL

let check = fn(err, op) {
    if (err) {
        putln("[error] ", op, ": ", err);
    }
};

putln("=== phishing_url_analyzer ===");
putln("Safe use: defensive URL triage only.");

let output_directory = "example_output/phishing_url_analyzer";
let input_file_path = output_directory + "/urls.json";
let feed_file_path = output_directory + "/phishing_domains.txt";
let graph_path = output_directory + "/url_graph";
let report_path = output_directory + "/report.json";

let made, _ = fs_mkdir(output_directory);
if (made == false) {
    putln("failed to create output directory");
}

let exists, err = fs_exists(input_file_path);
check(err, "fs_exists");
if (exists == false) {
    let seed = {"urls": ["http://example.com", "http://suspicious-domain.xyz"]};
    let seed_json, err = json_stringify(seed);
    check(err, "json_stringify seed");
    let seeded, err = fs_write(input_file_path, seed_json);
    check(err, "fs_write seed");
    if (seeded) {
        putln("seeded test dataset: ", input_file_path);
    }
}

let feed_resp, err = http_get("https://raw.githubusercontent.com/mitchellkrogza/Phishing.Database/master/phishing-domains-ACTIVE.txt");
check(err, "http_get feed");
let feed_written, err = fs_write(feed_file_path, feed_resp["body"]);
check(err, "fs_write feed");
if (feed_written == false) {
    putln("failed to write feed file");
}

let source_json, err = fs_read(input_file_path);
check(err, "fs_read input");
let parsed, err = json_parse(source_json);
check(err, "json_parse input");
let urls = parsed["urls"];

let NODE_URL = 1;
let NODE_DOMAIN = 2;
let NODE_RISK = 3;
let EDGE_RESOLVES_TO = 1;
let EDGE_HAS_RISK = 2;

let db, err = db_open_disk(graph_path);
check(err, "db_open_disk");
let findings = [];

for (url in urls) {
    // The URL is attacker-authored and goes into a Lua string: strip quotes and backslashes first.
    let url_for_lua = text_replace(text_replace(url, "'", ""), "\\", "");
    let extract_lua = "local u='" + url_for_lua + "'; local d=string.match(u,'^https?://([^/]+)'); if not d then return '' end; return d";
    let extracted, err = lua_run_string(extract_lua);
    check(err, "lua_run_string extract");
    let domain = extracted["result"];

    let domain_for_lua = text_replace(text_replace(domain, "'", ""), "\\", "");
    let feed_path_for_lua = text_replace(text_replace(feed_file_path, "'", ""), "\\", "");
    let listed_lua = "local data,err=mutant.read_file('" + feed_path_for_lua + "'); if not data then return '0' end; local d='" + domain_for_lua + "'; local pad='\\n'..data..'\\n'; if string.find(pad,'\\n'..d..'\\n',1,true) then return '1' end; return '0'";
    let listed_result, err = lua_run_string(listed_lua);
    check(err, "lua_run_string listed");
    let listed = listed_result["result"] == "1";

    let resp, err = http_get(url);
    check(err, "http_get url");

    let risk_score = 5;
    if (listed) {
        risk_score = risk_score + 70;
    }
    if (resp["status"] > 399) {
        risk_score = risk_score + 20;
    }
    if (resp["error"] != "") {
        risk_score = risk_score + 15;
    }
    if (risk_score > 100) {
        risk_score = 100;
    }

    let severity = "low";
    if (risk_score > 39) {
        severity = "medium";
    }
    if (risk_score > 69) {
        severity = "high";
    }

    let url_node, err = db_add_node(db, NODE_URL);
    check(err, "db_add_node url");
    let _, err = db_index_prop(db, url_node, "url", url);
    check(err, "db_index_prop");

    let domain_node, err = db_add_node(db, NODE_DOMAIN);
    check(err, "db_add_node domain");
    let _, err = db_index_prop(db, domain_node, "domain", domain);
    check(err, "db_index_prop");
    let _, err = db_add_edge(db, url_node, domain_node, EDGE_RESOLVES_TO);
    check(err, "db_add_edge");

    let risk_node, err = db_add_node(db, NODE_RISK);
    check(err, "db_add_node risk");
    let score_text, err = json_stringify(risk_score);
    check(err, "json_stringify risk_score");
    let _, err = db_index_prop(db, risk_node, "score", score_text);
    check(err, "db_index_prop");
    let _, err = db_index_prop(db, risk_node, "severity", severity);
    check(err, "db_index_prop");
    let listed_text, err = json_stringify(listed);
    check(err, "json_stringify listed");
    let _, err = db_index_prop(db, risk_node, "listed", listed_text);
    check(err, "db_index_prop");
    let _, err = db_add_edge(db, url_node, risk_node, EDGE_HAS_RISK);
    check(err, "db_add_edge");

    findings = push(findings, {"url": url, "domain": domain, "listed_in_feed": listed, "http_status": resp["status"], "risk_score": risk_score, "severity": severity, "error": resp["error"]});
}

let stats, err = db_stats(db);
check(err, "db_stats");
let closed, err = db_close(db);
check(err, "db_close");
if (closed == false) {
    putln("db close error");
}

let report = {"profile": "phishing_url_analyzer", "input_file": input_file_path, "urls_processed": len(urls), "feed_status": feed_resp["status"], "feed_error": feed_resp["error"], "graph_path": graph_path, "graph_stats": stats, "findings": findings};

let report_json, err = json_stringify(report);
check(err, "json_stringify report");
let written, err = fs_write(report_path, report_json);
check(err, "fs_write report");
if (written) {
    putln("wrote report: ", report_path);
} else {
    putln("failed to write report");
}
