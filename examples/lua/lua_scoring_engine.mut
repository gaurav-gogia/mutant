// Score a risk event with a Lua rule run in the sandbox.

let rule = """
    local score = 0
    if fails > 5 then score = score + 40 end
    if off_hours then score = score + 30 end
    return score
    """;

let build_script = fn(fails, off_hours) {
    let facts = "local fails = " + to_string(fails) + "\nlocal off_hours = " + to_string(off_hours) + "\n";
    return facts + rule;
};

let score_event = fn(fails, off_hours) {
    let result, err = lua_run_string(build_script(fails, off_hours));
    if (err) {
        putln("[error] lua_run_string:", err);
        return -1;
    }
    if (!result["ok"]) {
        putln("[lua script error]", result["error"]);
        return -1;
    }
    return result["result"];
};

putln("=== lua_scoring_engine ===");
putln("8 fails, off-hours -> score", score_event(8, true));
putln("2 fails, business hours -> score", score_event(2, false));
putln("9 fails, business hours -> score", score_event(9, false));
putln(true);
