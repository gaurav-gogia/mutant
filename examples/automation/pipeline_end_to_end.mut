// Triage pipeline: a policy, a cache, a regex check and a beacon detector.

putln("=== End-to-End Triage Pipeline ===");

let policy_module = r"""
    package e2e

    default allow = false

    allow {
      input.score < 80
    }

    decision = {
      "allow": allow,
      "score": input.score,
    }

    rules = [{"id":"score_lt_80"}]
    """;
let options = {"module": policy_module};
options["eval_query"] = "data.e2e.decision";
options["allow_query"] = "data.e2e.allow";
options["rules_query"] = "data.e2e.rules";
let loaded, err = policy_load("e2e", options);
putln("policy_load:", loaded, "err:", err);

let copen, err = cache_open("e2e_cache");
putln("cache_open:", copen, "err:", err);

let indicator = "powershell -enc aGVsbG8=";
let has_enc, enc_err = regex_match("-enc", indicator);
if (enc_err) {
    putln("[error] regex_match:", enc_err);
}
let score = 25;
if (has_enc) {
    score = score + 60;
}

let decision, err = policy_eval("e2e", {"score": score});
putln("policy_eval:", decision, "err:", err);

let _, _ = cache_put("e2e_cache", "last_score", score);
let entry, err = cache_get("e2e_cache", "last_score");
putln("cache_get(last_score):", entry, "err:", err);

let beacons = [{"dst": "c2.evil.test"}, {"dst": "c2.evil.test"}, {"dst": "c2.evil.test"}];
let det, err = detect_network_beacon(beacons);
putln("detect_network_beacon:", det, "err:", err);
