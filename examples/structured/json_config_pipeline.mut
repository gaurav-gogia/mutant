// Parse nested JSON, transform it, and serialize it again.

let run = fn() {
    putln("=== json_config_pipeline ===");

    let source = r"""
        {
          "service": "scanner",
          "enabled": true,
          "targets": [
            {"host": "10.0.0.1", "ports": [22, 80, 443]},
            {"host": "10.0.0.2", "ports": [3389]}
          ],
          "limits": {"timeout_ms": 1500, "max_hosts": 50}
        }
        """;
    let doc, err = json_parse(source);
    if (err) {
        putln("[error] json_parse:", err);
        return false;
    }
    putln("service:", doc["service"]);
    putln("timeout_ms:", doc["limits"]["timeout_ms"]);

    for (t in doc["targets"]) {
        putf("  target: %s (%d ports)\n", t["host"], len(t["ports"]));
    }

    let total_ports = reduce(doc["targets"], fn(acc, t) {
        return acc + len(t["ports"]);
    }, 0);
    let enriched = set(doc, "total_ports", total_ports);
    enriched = set(enriched, "generated_by", "json_config_pipeline");

    let out, serr = json_stringify(enriched);
    if (serr) {
        putln("[error] json_stringify:", serr);
        return false;
    }
    putln("re-serialized:", out);

    let encoded = base64_encode(out);
    putln("base64 length:", len(encoded));
    let decoded, derr = base64_decode(encoded);
    if (derr) {
        putln("[error] base64_decode:", derr);
        return false;
    }
    putln("round-trip matches:", to_string(decoded) == out);

    let n, cerr = to_int("41");
    if (cerr) {
        putln("[error] to_int:", cerr);
        return false;
    }
    putln("parsed int + 1:", n + 1);
    return true;
};

run();
